amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local cargo_fmt = (Builtins.cargo_fmt) {
  workspace_indicator = "Cargo.toml"
}

local cargo_clippy = (Builtins.cargo_clippy) {
  workspace_indicator = "Cargo.toml"
}

local staged_docs = new Step {
  glob = List("**/*.md", "criv.toml", ".rumdl.toml")
  check_first = true
  check = "cargo run --quiet -- check"
  fix = "cargo run --quiet -- check --fix"
}

local enforce_commit = new Step {
  check = "cargo run --quiet -- enforce --stage commit"
}

local enforce_push = new Step {
  check = "cargo run --quiet -- enforce --stage push"
}

local cargo_test = new Step {
  glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
  check = "cargo test --workspace"
}

local toml_fmt = (Builtins.taplo_format) {
  glob = List("**/*.toml", ".cargo/**/*.toml")
}

local plugin_files = List(
  ".obsidian/plugins/criv/package.json",
  ".obsidian/plugins/criv/package-lock.json",
  ".obsidian/plugins/criv/tsconfig.json",
  ".obsidian/plugins/criv/**/*.ts",
  ".obsidian/plugins/criv/**/*.mjs",
  ".obsidian/plugins/criv/test/**/*.mjs",
  ".obsidian/plugins/criv/fixtures/**/*.json",
  "crates/criv-wasm/**",
  "mise.toml",
)

local plugin_format_check = new Step {
  glob = plugin_files
  check = "mise run plugin-format-check"
}

local plugin_lint = new Step {
  glob = plugin_files
  check = "mise run plugin-lint"
}

local plugin_test = new Step {
  glob = plugin_files
  check = "mise run plugin-test"
}

local plugin_build = new Step {
  glob = plugin_files
  check = "mise run plugin-build"
}

local vscode_files = List(
  "extensions/vscode-criv/package.json",
  "extensions/vscode-criv/package-lock.json",
  "extensions/vscode-criv/tsconfig.json",
  "extensions/vscode-criv/**/*.ts",
  "extensions/vscode-criv/**/*.mjs",
  "extensions/vscode-criv/**/*.json",
  "extensions/vscode-criv/test/**/*.ts",
  "extensions/vscode-criv/scripts/**/*.mjs",
  "crates/criv-wasm/**",
  "mise.toml",
)

local vscode_lint = new Step {
  glob = vscode_files
  check = "mise run vscode-lint"
}

local vscode_json_diagnostics = new Step {
  glob = List(
    "extensions/vscode-criv/package.json",
    "extensions/vscode-criv/language-configuration.json",
    "extensions/vscode-criv/test/integration/runner.ts",
    "extensions/vscode-criv/test/run-integration.mjs",
    "mise.toml",
  )
  check = "mise run vscode-json-diagnostics"
}

local enforce_ci = new Step {
  check = "cargo run --quiet -- enforce --stage ci"
}

local actionlint = new Step {
  glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
  check = "actionlint"
}

local zizmor = new Step {
  glob = List(
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "**/action.yml",
    "**/action.yaml",
    ".github/dependabot.yml",
    ".github/dependabot.yaml",
  )
  check = "zizmor --offline --strict-collection ."
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["actionlint"] = actionlint
      ["zizmor"] = zizmor
      ["vscode-lint"] = vscode_lint
      ["vscode-json-diagnostics"] = vscode_json_diagnostics
      ["criv-check"] = staged_docs
      ["criv-enforce"] = enforce_commit
    }
  }

  ["pre-push"] {
    steps {
      ["cargo-clippy"] = cargo_clippy
      ["cargo-test"] = cargo_test
      ["criv-enforce"] = enforce_push
    }
  }

  ["check"] {
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["cargo-clippy"] = cargo_clippy
      ["actionlint"] = actionlint
      ["zizmor"] = zizmor
      ["cargo-test"] = cargo_test
      ["plugin-format-check"] = plugin_format_check
      ["plugin-lint"] = plugin_lint
      ["plugin-test"] = plugin_test
      ["plugin-build"] = plugin_build
      ["vscode-lint"] = vscode_lint
      ["vscode-json-diagnostics"] = vscode_json_diagnostics
      ["criv-check"] = staged_docs
      ["criv-enforce-ci"] = enforce_ci
    }
  }

  ["fix"] {
    fix = true
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["criv-check"] = staged_docs
    }
  }
}
