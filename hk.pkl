amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local cargo_fmt = (Builtins.cargo_fmt) {
  workspace_indicator = "Cargo.toml"
}

local cargo_clippy = new Step {
  glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
  check = "cargo clippy --locked --workspace --all-targets -- -D warnings"
}

local staged_docs = new Step {
  glob = List("**/*.md", "criv.toml", ".rumdl.toml")
  check_first = true
  check = "cargo run --locked --quiet -- check --changed"
  fix = "cargo run --locked --quiet -- check --fix"
}

local full_docs = new Step {
  glob = List("**/*.md", "criv.toml", ".rumdl.toml")
  check_first = true
  check = "cargo run --locked --quiet -- check${GITHUB_ACTIONS:+ --format github}"
  fix = "cargo run --locked --quiet -- check --fix"
}

local enforce_commit = new Step {
  check = "cargo run --locked --quiet -- enforce --stage commit"
}

local enforce_push = new Step {
  check = "cargo run --locked --quiet -- enforce --stage push"
}

local cargo_test = new Step {
  glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
  check = "cargo test --locked --workspace"
}

local hawk = new Step {
  glob = List(
    "Cargo.toml",
    "Cargo.lock",
    "hawk.toml",
    "mise.toml",
    "src/**/*.rs",
    "crates/**/*.rs",
    "hk.pkl",
  )
  check = "cargo hawk check --manifest-path Cargo.toml --target-dir target/hawk --exclude-crate criv_wasm -D warnings"
  env {
    ["RUSTC_WRAPPER"] = ""
    ["SCCACHE_GHA_ENABLED"] = "false"
  }
}

local toml_fmt = (Builtins.taplo_format) {
  glob = List("**/*.toml", ".cargo/**/*.toml")
}

local enforce_ci = new Step {
  check = "cargo run --locked --quiet -- enforce --stage ci"
}

local cargo_audit = new Step {
  check = "cargo audit --no-fetch || { criv_audit_exit=$?; echo \"cargo audit is monitor-only (exit $criv_audit_exit)\"; true; }"
}

local actionlint = new Step {
  glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
  check = "actionlint"
}

local shellcheck = new Step {
  glob = List("**/*.sh")
  check = "shellcheck {{files}}"
}

local zizmor = new Step {
  glob = List(
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "**/action.yml",
    "**/action.yaml",
    ".github/dependabot.yml",
    ".github/dependabot.yaml",
  )
  check = "zizmor --offline --strict-collection ."
}

local ci_cargo_clippy = (cargo_clippy) {
  depends = List("cargo-test")
}

local ci_full_docs = (full_docs) {
  depends = List("cargo-clippy")
}

local ci_enforce = (enforce_ci) {
  depends = List("criv-check")
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["actionlint"] = actionlint
      ["shellcheck"] = shellcheck
      ["zizmor"] = zizmor
      ["criv-check"] = staged_docs
      ["criv-enforce"] = enforce_commit
    }
  }

  ["pre-push"] {
    steps {
      ["cargo-clippy"] = cargo_clippy
      ["cargo-test"] = cargo_test
      ["hawk"] = hawk
      ["criv-enforce"] = enforce_push
    }
  }

  ["check"] {
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["cargo-clippy"] = ci_cargo_clippy
      ["actionlint"] = actionlint
      ["shellcheck"] = shellcheck
      ["zizmor"] = zizmor
      ["cargo-test"] = cargo_test
      ["hawk"] = hawk
      ["cargo-audit"] = cargo_audit
      ["criv-check"] = ci_full_docs
      ["criv-enforce-ci"] = ci_enforce
    }
  }

  ["fix"] {
    fix = true
    steps {
      ["cargo-fmt"] = cargo_fmt
      ["toml-fmt"] = toml_fmt
      ["criv-check"] = full_docs
    }
  }
}
