model {
  extend criv {
    sharedRenderer = container 'Shared LikeC4 renderer' {
      technology 'TypeScript, React, and LikeC4'
      description 'Provides the compiled-model contract and the browser renderer used by both editor adapters.'
      link ../../packages/criv-likec4/src/renderer.ts 'source'

      modelContract = component 'Model contract' {
        technology 'TypeScript'
        description 'Defines the prepared model and view contract that editor adapters pass without conversion.'
        link ../../packages/criv-likec4/src/protocol.ts 'source'
      }
      diagramRenderer = component 'Diagram renderer' {
        technology 'TypeScript, React, and LikeC4'
        description 'Mounts, navigates, exports, and disposes a LikeC4 diagram in an adapter-owned DOM element.'
        link ../../packages/criv-likec4/src/renderer.ts 'source'
      }
    }
  }
}

views {
  global style architectureTheme

  view sharedRendererComponents of criv.sharedRenderer {
    title 'Components / Shared renderer'
    description 'The model contract and browser renderer in the shared package.'

    include *
    include
      criv.sharedRenderer.diagramRenderer with {
        navigateTo codeSharedRenderer
      }
  }
}
