model {
  maintainer = person 'Repository maintainer' {
    #external
    description 'Reviews decisions and changes, and operates the repository toolchain.'
    link ../../README.md 'source'
  }

  codingAgent = person 'Coding agent' {
    #external
    description 'Changes source code and vault content, follows repository decisions, and checks its work.'
  }

  criv = softwareSystem 'criv' {
    description 'Validates and publishes a local knowledge graph between repository documentation, decisions, architecture, and source code.'
    link ../../src/lib.rs 'source'
  }

  repository = softwareSystem 'Project repository' {
    #external
    technology 'Working tree and Git history'
    description 'Holds source code, documents, decisions, C4 models, configuration, and commit history.'
    link ../../criv.toml 'source'
  }

  obsidian = softwareSystem 'Obsidian' {
    #external
    technology 'Electron desktop application'
    description 'Shows repository documents and hosts the criv companion plugin.'
  }

  vscode = softwareSystem 'VS Code-compatible editor' {
    #external
    technology 'Electron desktop application'
    description 'Edits repository files and hosts the criv companion extension.'
  }

  githubActions = softwareSystem 'GitHub Actions' {
    #external
    technology 'Hosted continuous integration'
    description 'Runs repository validation on each push and pull request.'
  }
}

views {
  global style architectureTheme

  view index {
    title 'Overview / System context'
    description 'How maintainers, coding agents, editors, and CI use criv around one project repository.'

    include maintainer
    include codingAgent
    include
      criv with {
        navigateTo containers
      }
    include repository
    include obsidian
    include vscode
    include githubActions
  }
}
