model {
  extend criv {
    stateProjection = container 'State projection library' {
      technology 'Rust compiled to WebAssembly'
      description 'Validates the published state contract and projects safe editor-facing data.'
      link ../../crates/criv-wasm/src/lib.rs 'source'

      stateDecoder = component 'State decoder' {
        technology 'Rust and serde'
        description 'Creates one loaded revision and rejects invalid JSON or an unsupported state schema.'
        link ../../crates/criv-wasm/src/lib.rs#LoadedState 'source'
      }
      graphProjection = component 'Graph projection' {
        technology 'Rust and WebAssembly'
        description 'Builds one initial batch and a prepared graph-node lookup index.'
        link ../../crates/criv-wasm/src/lib.rs#initial_projections 'source'
      }
      selectorProjection = component 'Selector projection' {
        technology 'Rust and WebAssembly'
        description 'Ranks safe source selectors from prepared revision data.'
        link ../../crates/criv-wasm/src/lib.rs#suggest_selectors 'source'
      }
    }
  }
}

views {
  global style architectureTheme

  view stateProjectionComponents of criv.stateProjection {
    title 'Components / State projection'
    description 'How the shared WebAssembly library validates state and returns safe editor data.'

    include *
  }
}
