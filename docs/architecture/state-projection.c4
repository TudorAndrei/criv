model {
  extend criv {
    stateWire = container 'State contract library' {
      technology 'Rust library'
      description 'Owns the shared State schema, serialized wire rows, and stable Source identity text.'
      link ../../crates/criv-state-wire/src/lib.rs 'source'

      stateDocument = component 'State document' {
        technology 'Rust and serde'
        description 'Defines the shared State schema identity and serialized wire rows.'
        link ../../crates/criv-state-wire/src/lib.rs 'source'
      }
      sourceIdentity = component 'Source identity' {
        technology 'Rust'
        description 'Owns structured Source identity and stable selector text conversion.'
        link ../../crates/criv-state-wire/src/source_identity.rs 'source'
      }
    }

    stateProjection = container 'State projection library' {
      technology 'Rust compiled to WebAssembly'
      description 'Validates the published state contract and projects safe editor-facing data.'
      link ../../crates/criv-wasm/src/lib.rs 'source'

      stateDecoder = component 'State decoder' {
        technology 'Rust and serde'
        description 'Creates one loaded revision and rejects invalid JSON or an unsupported state schema.'
        link ../../crates/criv-wasm/src/decode.rs 'source'
      }
      graphProjection = component 'Graph projection' {
        technology 'Rust and WebAssembly'
        description 'Builds one initial batch and a prepared graph-node lookup index.'
        link ../../crates/criv-wasm/src/projection.rs#initial_projections_from_js 'source'
      }
      architectureProjection = component 'Architecture projection' {
        technology 'Rust and WebAssembly'
        description 'Validates the LikeC4 wrapper and raw model, then returns the complete editor renderer model.'
        link ../../crates/criv-wasm/src/likec4.rs#prepare_architecture 'source'
      }
      selectorProjection = component 'Selector projection' {
        technology 'Rust and WebAssembly'
        description 'Ranks safe source selectors from prepared revision data.'
        link ../../crates/criv-wasm/src/source.rs#suggest_selectors 'source'
      }
    }
  }

  criv.stateProjection.stateDecoder -> criv.stateWire.stateDocument 'Decodes the shared State document' {
    technology 'Rust crate'
  }
  criv.stateProjection.selectorProjection -> criv.stateWire.sourceIdentity 'Parses Source identity text' {
    technology 'Rust crate'
  }
  criv.stateProjection.architectureProjection -> criv.stateProjection.stateDecoder 'Validates the optional architecture value'
}

views {
  global style architectureTheme

  view stateProjectionComponents of criv.stateProjection {
    title 'Components / State projection'
    description 'How the shared WebAssembly library validates state and returns safe editor data.'

    include *
    include criv.stateWire
    include criv.stateWire.*
  }
}
