// Code architecture for the Obsidian companion plugin.
model {
  extend criv.obsidianPlugin.obsidianController {
    mainModule = module 'criv-obsidian::main' {
      technology 'TypeScript'
      description 'Constructs owners and connects their Obsidian registrations and disposal.'
      link ../../.obsidian/plugins/criv/src/main.ts 'source'
    }
    portsModule = module 'criv-obsidian::ports' {
      technology 'TypeScript'
      description 'Defines the immutable State status and narrow injected owner ports.'
      link ../../.obsidian/plugins/criv/src/ports.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianStateOwner {
    stateOwnerModule = module 'criv-obsidian::state::owner' {
      technology 'TypeScript'
      description 'Owns file tokens, loaded revisions, status generations, queries, and disposal.'
      link ../../.obsidian/plugins/criv/src/state/owner.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianC4View {
    c4ViewModule = module 'criv-obsidian::c4-view' {
      technology 'TypeScript'
      description 'Owns the C4 FileView, preview transaction, navigation, export, save, and cleanup.'
      link ../../.obsidian/plugins/criv/src/c4-view.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianSourcePanel {
    sourcePanelModule = module 'criv-obsidian::source::panel' {
      technology 'TypeScript'
      description 'Owns the singleton source-panel leaf and its active-note rendering.'
      link ../../.obsidian/plugins/criv/src/source/panel.ts 'source'
    }
    assetModule = module 'criv-obsidian::source::assets' {
      technology 'TypeScript and Obsidian resource API'
      description 'Builds cache-keyed resource paths for verified passive image thumbnails.'
      link ../../.obsidian/plugins/criv/src/source/assets.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianSourceReferences {
    sourceReferencesModule = module 'criv-obsidian::source::references' {
      technology 'TypeScript and CodeMirror'
      description 'Owns suggestions, hover lifecycle, link decoration, and drift decoration.'
      link ../../.obsidian/plugins/criv/src/source/references.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianSourcePreview {
    sourcePreviewModule = module 'criv-obsidian::source::preview' {
      technology 'TypeScript and DOM'
      description 'Reads, highlights, and renders source excerpts without lifecycle state.'
      link ../../.obsidian/plugins/criv/src/source/preview.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianSettings {
    settingsModule = module 'criv-obsidian::settings' {
      technology 'TypeScript'
      description 'Owns settings data, persistence, and the Obsidian settings tab.'
      link ../../.obsidian/plugins/criv/src/settings.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianState {
    coreModule = module 'criv-obsidian::source::model' {
      technology 'TypeScript'
      description 'Defines the plugin state model and pure source-reference operations.'
      link ../../.obsidian/plugins/criv/src/source/model.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianWasm {
    wasmModule = module 'criv-obsidian::state::wasm' {
      technology 'TypeScript and Rust WebAssembly'
      description 'Loads the WebAssembly API used to validate and query criv State.'
      link ../../.obsidian/plugins/criv/src/state/wasm.ts 'source'
    }
  }

  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianController.portsModule 'Injects narrow owner ports'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianStateOwner 'Constructs the State lifecycle'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianC4View 'Registers the C4 FileView'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianSourcePanel 'Registers the source panel'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianSourceReferences 'Registers source-reference features'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianSettings 'Registers settings'
  criv.obsidianPlugin.obsidianStateOwner.stateOwnerModule -> criv.obsidianPlugin.obsidianWasm.wasmModule 'Loads and queries validated revisions'
  criv.obsidianPlugin.obsidianStateOwner.stateOwnerModule -> criv.obsidianPlugin.obsidianState.coreModule 'Publishes editor projections'
  criv.obsidianPlugin.obsidianC4View.c4ViewModule -> criv.sharedRenderer.diagramRenderer.rendererModule 'Owns a renderer revision'
  criv.obsidianPlugin.obsidianC4View.c4ViewModule -> criv.sharedRenderer.modelContract.protocolModule 'Selects a named view'
  criv.obsidianPlugin.obsidianSourcePanel.sourcePanelModule -> criv.obsidianPlugin.obsidianSourcePreview.sourcePreviewModule 'Renders panel excerpts'
  criv.obsidianPlugin.obsidianSourcePanel.sourcePanelModule -> criv.obsidianPlugin.obsidianSourcePanel.assetModule 'Renders verified asset thumbnails'
  criv.obsidianPlugin.obsidianSourcePanel.sourcePanelModule -> criv.obsidianPlugin.obsidianStateOwner.stateOwnerModule 'Reads the active asset inventory'
  criv.obsidianPlugin.obsidianWasm.wasmModule -> criv.stateProjection.assetProjection.rustWasmAsset 'Receives projected asset rows'
  criv.obsidianPlugin.obsidianSourceReferences.sourceReferencesModule -> criv.obsidianPlugin.obsidianSourcePreview.sourcePreviewModule 'Renders hover excerpts'
}

views {
  global style architectureTheme

  view codeObsidianAdapter of criv.obsidianPlugin.obsidianController {
    title 'Code / Obsidian / Composition'
    description 'How the composition module injects ports and registers each lifecycle owner.'

    include *
    include criv.obsidianPlugin.obsidianStateOwner
    include criv.obsidianPlugin.obsidianC4View
    include criv.obsidianPlugin.obsidianSourcePanel
    include criv.obsidianPlugin.obsidianSourceReferences
    include criv.obsidianPlugin.obsidianSettings
  }
}
