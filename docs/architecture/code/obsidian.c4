// Code architecture for the Obsidian companion plugin.
model {
  extend criv.obsidianPlugin.obsidianController {
    mainModule = module 'criv-obsidian::main' {
      technology 'TypeScript'
      description 'Activates the plugin and connects Obsidian views and editor features.'
      link ../../.obsidian/plugins/criv/src/main.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianState {
    coreModule = module 'criv-obsidian::core' {
      technology 'TypeScript'
      description 'Defines the plugin state model and pure source-reference operations.'
      link ../../.obsidian/plugins/criv/src/core.ts 'source'
    }
  }
  extend criv.obsidianPlugin.obsidianWasm {
    wasmModule = module 'criv-obsidian::wasm' {
      technology 'TypeScript and Rust WebAssembly'
      description 'Loads the WebAssembly API used to validate and query criv state.'
      link ../../.obsidian/plugins/criv/src/wasm.ts 'source'
    }
  }

  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianState.coreModule 'Builds editor views'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.obsidianPlugin.obsidianWasm.wasmModule 'Validates state and resolves selectors'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.sharedRenderer.diagramRenderer.rendererModule 'Renders C4 diagrams'
  criv.obsidianPlugin.obsidianController.mainModule -> criv.sharedRenderer.modelContract.protocolModule 'Reads the model contract'
  criv.obsidianPlugin.obsidianWasm.wasmModule -> criv.obsidianPlugin.obsidianState.coreModule 'Maps validated state to editor snapshots'
}

views {
  global style architectureTheme

  view codeObsidianAdapter of criv.obsidianPlugin.obsidianController {
    title 'Code / Obsidian / Adapter'
    description 'The TypeScript modules that connect Obsidian to state and the renderer.'

    include *
    include criv.obsidianPlugin.obsidianState.*
    include criv.obsidianPlugin.obsidianWasm.*
    include criv.sharedRenderer.diagramRenderer.*
    include criv.sharedRenderer.modelContract.*
  }
}
