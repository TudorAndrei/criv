// Code architecture for the VS Code companion extension. `src/nodeModuleShim`
// is a bundler shim and stays outside the architecture.
model {
  extend criv.vscodeExtension.vscodeController {
    extensionModule = module 'criv-vscode::extension' {
      technology 'TypeScript'
      description 'Activates the extension and connects commands, state, navigation, and previews.'
      link ../../extensions/vscode-criv/src/extension.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodePreview {
    previewModule = module 'criv-vscode::c4::preview' {
      technology 'TypeScript'
      description 'Implements the VS Code custom editor for C4 previews.'
      link ../../extensions/vscode-criv/src/c4/preview.ts 'source'
    }
    previewHtmlModule = module 'criv-vscode::c4::previewHtml' {
      technology 'TypeScript'
      description 'Builds the secure webview document and preview bootstrap data.'
      link ../../extensions/vscode-criv/src/c4/previewHtml.ts 'source'
    }
    previewModelModule = module 'criv-vscode::c4::previewModel' {
      technology 'TypeScript'
      description 'Selects the named view owned by the opened C4 artifact.'
      link ../../extensions/vscode-criv/src/c4/previewModel.ts 'source'
    }
    webviewModule = module 'criv-vscode::c4::webview' {
      technology 'TypeScript'
      description 'Mounts the shared renderer inside the webview and synchronizes navigation.'
      link ../../extensions/vscode-criv/src/c4/webview.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeState {
    stateStoreModule = module 'criv-vscode::state::store' {
      technology 'TypeScript'
      description 'Loads and broadcasts the current workspace state.'
      link ../../extensions/vscode-criv/src/state/store.ts 'source'
    }
    stateModelModule = module 'criv-vscode::state::model' {
      technology 'TypeScript'
      description 'Converts validated state into extension-facing snapshots and C4 artifacts.'
      link ../../extensions/vscode-criv/src/state/model.ts 'source'
    }
    wasmModule = module 'criv-vscode::state::wasm' {
      technology 'TypeScript and Rust WebAssembly'
      description 'Loads the WebAssembly API used to validate and query criv state.'
      link ../../extensions/vscode-criv/src/state/wasm.ts 'source'
    }
    configModule = module 'criv-vscode::config::reader' {
      technology 'TypeScript'
      description 'Reads the extension settings for the active workspace.'
      link ../../extensions/vscode-criv/src/config/reader.ts 'source'
    }
    configModelModule = module 'criv-vscode::config::model' {
      technology 'TypeScript'
      description 'Defines and validates the extension settings model.'
      link ../../extensions/vscode-criv/src/config/model.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeNavigation {
    languageFeaturesModule = module 'criv-vscode::navigation::languageFeatures' {
      technology 'TypeScript'
      description 'Provides document links, hovers, definitions, and references.'
      link ../../extensions/vscode-criv/src/navigation/languageFeatures.ts 'source'
    }
    sourceReferencesModule = module 'criv-vscode::navigation::references' {
      technology 'TypeScript'
      description 'Resolves wiki-link source references against validated state.'
      link ../../extensions/vscode-criv/src/navigation/references.ts 'source'
    }
    sourceTargetModule = module 'criv-vscode::navigation::target' {
      technology 'TypeScript'
      description 'Converts resolved selectors into editor locations.'
      link ../../extensions/vscode-criv/src/navigation/target.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeDiagnostics {
    checkDiagnosticsModule = module 'criv-vscode::diagnostics::publisher' {
      technology 'TypeScript'
      description 'Publishes criv check results as workspace diagnostics.'
      link ../../extensions/vscode-criv/src/diagnostics/publisher.ts 'source'
    }
    checkDiagnosticModelModule = module 'criv-vscode::diagnostics::model' {
      technology 'TypeScript'
      description 'Parses criv check JSON into a diagnostic model.'
      link ../../extensions/vscode-criv/src/diagnostics/model.ts 'source'
    }
    checkOutputModule = module 'criv-vscode::diagnostics::output' {
      technology 'TypeScript'
      description 'Writes criv check output to the extension output channel.'
      link ../../extensions/vscode-criv/src/diagnostics/output.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeCommands {
    commandsModule = module 'criv-vscode::commands::identifiers' {
      technology 'TypeScript'
      description 'Declares the command identifiers registered by the extension.'
      link ../../extensions/vscode-criv/src/commands/identifiers.ts 'source'
    }
    commandRunnerModule = module 'criv-vscode::commands::runner' {
      technology 'TypeScript and Node.js child processes'
      description 'Runs the criv binary in the workspace and returns its result.'
      link ../../extensions/vscode-criv/src/commands/runner.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeExplorer {
    treeModule = module 'criv-vscode::tree' {
      technology 'TypeScript'
      description 'Builds the vault tree from validated state.'
      link ../../extensions/vscode-criv/src/tree.ts 'source'
    }
  }

  extend criv.vscodeExtension.vscodeAssets {
    assetModule = module 'criv-vscode::assets' {
      technology 'TypeScript'
      description 'Validates a requested asset path against the active projected State inventory.'
      link ../../extensions/vscode-criv/src/assets.ts 'source'
    }
  }

  // Extension activation.
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodePreview.previewModule 'Registers the custom editor'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeState.stateStoreModule 'Observes workspace state'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeState.wasmModule 'Creates the state bridge'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeState.configModule 'Reads the extension settings'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeNavigation.languageFeaturesModule 'Registers language features'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeNavigation.sourceTargetModule 'Opens resolved source targets'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeDiagnostics.checkDiagnosticsModule 'Publishes check diagnostics'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeDiagnostics.checkOutputModule 'Writes check output'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeCommands.commandsModule 'Registers command identifiers'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeCommands.commandRunnerModule 'Runs criv commands'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeExplorer.treeModule 'Registers the vault tree'
  criv.vscodeExtension.vscodeController.extensionModule -> criv.vscodeExtension.vscodeAssets.assetModule 'Opens authorized documentation assets'

  // Preview editor.
  criv.vscodeExtension.vscodePreview.previewModule -> criv.vscodeExtension.vscodePreview.previewHtmlModule 'Builds preview documents'
  criv.vscodeExtension.vscodePreview.previewModule -> criv.vscodeExtension.vscodePreview.previewModelModule 'Selects the initial named view'
  criv.vscodeExtension.vscodePreview.previewModule -> criv.vscodeExtension.vscodeState.stateStoreModule 'Reads compiled C4 models'
  criv.vscodeExtension.vscodePreview.previewModule -> criv.vscodeExtension.vscodeCommands.commandsModule 'Runs refresh commands'
  criv.vscodeExtension.vscodePreview.webviewModule -> criv.sharedRenderer.diagramRenderer.rendererModule 'Mounts diagrams'
  criv.vscodeExtension.vscodePreview.webviewModule -> criv.sharedRenderer.modelContract.protocolModule 'Reads the model contract'

  // Workspace state.
  criv.vscodeExtension.vscodeState.stateStoreModule -> criv.vscodeExtension.vscodeState.stateModelModule 'Builds extension snapshots'
  criv.vscodeExtension.vscodeState.stateStoreModule -> criv.vscodeExtension.vscodeState.wasmModule 'Owns loaded state revisions'
  criv.vscodeExtension.vscodeState.wasmModule -> criv.stateProjection.assetProjection.rustWasmAsset 'Receives projected asset rows'
  criv.vscodeExtension.vscodeState.configModule -> criv.vscodeExtension.vscodeState.configModelModule 'Validates the settings model'

  // Source navigation.
  criv.vscodeExtension.vscodeNavigation.languageFeaturesModule -> criv.vscodeExtension.vscodeNavigation.sourceReferencesModule 'Resolves source references'
  criv.vscodeExtension.vscodeNavigation.languageFeaturesModule -> criv.vscodeExtension.vscodeState.stateStoreModule 'Reads the current state'
  criv.vscodeExtension.vscodeNavigation.languageFeaturesModule -> criv.vscodeExtension.vscodeCommands.commandsModule 'Offers command links'
  criv.vscodeExtension.vscodeNavigation.sourceReferencesModule -> criv.vscodeExtension.vscodeState.stateModelModule 'Reads state snapshots'

  // Diagnostics.
  criv.vscodeExtension.vscodeDiagnostics.checkDiagnosticsModule -> criv.vscodeExtension.vscodeDiagnostics.checkDiagnosticModelModule 'Parses check results'
  criv.vscodeExtension.vscodeDiagnostics.checkDiagnosticsModule -> criv.vscodeExtension.vscodeNavigation.sourceTargetModule 'Anchors diagnostics to source'
  criv.vscodeExtension.vscodeDiagnostics.checkOutputModule -> criv.vscodeExtension.vscodeCommands.commandRunnerModule 'Reads command output'

  // Vault tree.
  criv.vscodeExtension.vscodeExplorer.treeModule -> criv.vscodeExtension.vscodeState.stateStoreModule 'Observes the current state'
  criv.vscodeExtension.vscodeExplorer.treeModule -> criv.vscodeExtension.vscodeState.stateModelModule 'Reads state snapshots'
  criv.vscodeExtension.vscodeAssets.assetModule -> criv.vscodeExtension.vscodeState.stateModelModule 'Authorizes active asset rows'
}

views {
  global style architectureTheme

  view codeVscodePreview of criv.vscodeExtension.vscodePreview {
    title 'Code / VS Code / Preview'
    description 'The TypeScript modules behind the custom architecture preview editor.'

    include *
    include criv.vscodeExtension.vscodeController.*
    include criv.vscodeExtension.vscodeState.stateStoreModule
    include criv.vscodeExtension.vscodeCommands.commandsModule
    include criv.sharedRenderer.diagramRenderer.*
    include criv.sharedRenderer.modelContract.*
  }

  view codeVscodeState of criv.vscodeExtension.vscodeState {
    title 'Code / VS Code / Workspace state'
    description 'The TypeScript modules that load, validate, and project criv state.'

    include *
    include criv.vscodeExtension.vscodeController.*
    include criv.vscodeExtension.vscodeNavigation.*
    include criv.vscodeExtension.vscodeExplorer.*
  }
}
