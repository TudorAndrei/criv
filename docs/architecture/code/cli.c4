// Code architecture for the criv CLI. Every node is a Rust module, and every
// relation is an import relation between modules. `criv::util` holds only
// non-I/O helpers and stays outside the architecture.
model {
  extend criv.cli.commandInterface {
    rustMain = module 'criv::main' {
      technology 'Rust'
      description 'Parses command-line arguments and reports process results.'
      link ../../src/main.rs 'source'
    }
    rustCriv = module 'criv' {
      technology 'Rust'
      description 'Exposes the library API and routes each operation to its workflow.'
      link ../../src/lib.rs 'source'
    }
  }

  extend criv.cli.installation {
    rustInit = module 'criv::init' {
      technology 'Rust'
      description 'Writes the vault scaffold and canonical configuration.'
      link ../../src/init.rs 'source'
    }
    rustInstall = module 'criv::install' {
      technology 'Rust'
      description 'Exposes generated-skill and editor installation operations.'
      link ../../src/install.rs 'source'
    }
    rustInstallSkills = module 'criv::install::skills' {
      technology 'Rust'
      description 'Installs and inspects the canonical generated skill inventory.'
      link ../../src/install/skills.rs 'source'
    }
    rustInstallEditor = module 'criv::install::editor' {
      technology 'Rust'
      description 'Finds a selected editor and installs the bundled local viewer.'
      link ../../src/install/editor.rs 'source'
    }
  }

  extend criv.cli.vaultModel {
    rustVault = module 'criv::vault' {
      technology 'Rust'
      description 'Builds the in-memory repository vault from documents and source data.'
      link ../../src/vault.rs 'source'
    }
    rustConfig = module 'criv::config' {
      technology 'Rust'
      description 'Reads and validates the canonical criv configuration.'
      link ../../src/config.rs 'source'
    }
  }

  extend criv.cli.repositoryHistory {
    rustGit = module 'criv::git' {
      technology 'Rust and git2'
      description 'Holds the embedded Git boundary for repository history and change sets.'
      link ../../src/git.rs 'source'
    }
  }

  extend criv.cli.repositoryFiles {
    rustRepository = module 'criv::repository' {
      technology 'Rust'
      description 'Exposes one capability-rooted repository handle and bound write scopes.'
      link ../../src/repository.rs 'source'
    }
    rustRepositoryFilesystem = module 'criv::repository::filesystem' {
      technology 'Rust, cap-std, and cap-fs-ext'
      description 'Privately implements no-follow traversal, atomic publication, permissions, links, and directory durability.'
      link ../../src/repository/filesystem.rs 'source'
    }
  }

  extend criv.cli.architectureService {
    rustC4 = module 'criv::c4' {
      technology 'Rust'
      description 'Exposes one C4 artifact and workspace loading interface.'
      link ../../src/c4.rs 'source'
    }
    rustC4Artifact = module 'criv::c4::artifact' {
      technology 'Rust'
      description 'Classifies C4 source files and reports file-local diagnostics.'
      link ../../src/c4/artifact.rs 'source'
    }
    rustLikeC4 = module 'criv::c4::likec4' {
      technology 'Rust'
      description 'Runs the LikeC4 bridge and returns models and diagnostics.'
      link ../../src/c4/likec4.rs 'source'
    }
  }

  extend criv.cli.sourceIntelligence {
    rustSource = module 'criv::source' {
      technology 'Rust'
      description 'Owns one Source state, its refresh lifecycle, and the crate-local Source interface.'
      link ../../src/source.rs 'source'
    }
    rustSourceCatalog = module 'criv::source::catalog' {
      technology 'Rust'
      description 'Privately implements stable Source path entries and target lookup.'
      link ../../src/source/catalog.rs 'source'
    }
    rustDiscovery = module 'criv::discovery' {
      technology 'Rust and ignore'
      description 'Selects Source, Vault, and Markdown files with profile-specific rules.'
      link ../../src/discovery/mod.rs 'source'
    }
    rustSourcePaths = module 'criv::source::paths' {
      technology 'Rust'
      description 'Converts selected repository bytes to Source text.'
      link ../../src/source/paths.rs 'source'
    }
    rustSourceGraph = module 'criv::source::graph' {
      technology 'Rust and tree-sitter'
      description 'Privately builds, caches, and reuses parsed Source graph data.'
      link ../../src/source/graph.rs 'source'
    }
    rustStructural = module 'criv::structural' {
      technology 'Rust and ast-grep'
      description 'Matches structural patterns against parsed source files.'
      link ../../src/structural.rs 'source'
    }
  }

  extend criv.cli.governanceEngine {
    rustCheck = module 'criv::check' {
      technology 'Rust'
      description 'Validates the loaded vault and produces structured diagnostics.'
      link ../../src/check.rs 'source'
    }
    rustPolicyScan = module 'criv::policy_scan' {
      technology 'Rust'
      description 'Evaluates configured policy patterns against repository content.'
      link ../../src/policy_scan.rs 'source'
    }
    rustAdr = module 'criv::adr' {
      technology 'Rust'
      description 'Resolves effective decision governance for each source scope.'
      link ../../src/adr.rs 'source'
    }
    rustSourceReconcile = module 'criv::adr::source_reconcile' {
      technology 'Rust'
      description 'Privately reconciles renamed and deleted source scopes for the ADR module.'
      link ../../src/adr/source_reconcile.rs 'source'
    }
    rustReconcileTransaction = module 'criv::adr::reconcile_transaction' {
      technology 'Rust'
      description 'Privately captures and restores the Git index and changed reconciliation files.'
      link ../../src/adr/reconcile_transaction.rs 'source'
    }
  }

  extend criv.cli.diagnosticLocations {
    rustDiagnostic = module 'criv::diagnostic' {
      technology 'Rust'
      description 'Validates UTF-8 byte spans and converts them to LSP and GitHub coordinates.'
      link ../../src/diagnostic.rs 'source'
    }
  }

  extend criv.cli.governanceEngine {
    rustEnforce = module 'criv::enforce' {
      technology 'Rust'
      description 'Selects the change scope for each enforcement stage and fails closed.'
      link ../../src/enforce.rs 'source'
    }
  }

  extend criv.cli.refreshCoordinator {
    rustWatch = module 'criv::watch' {
      technology 'Rust and notify'
      description 'Receives file changes and schedules incremental refresh sessions.'
      link ../../src/watch.rs 'source'
    }
    rustRefresh = module 'criv::refresh' {
      technology 'Rust'
      description 'Coordinates load, validation, architecture output, and state publication.'
      link ../../src/refresh.rs 'source'
    }
  }

  extend criv.cli.statePublisher {
    rustState = module 'criv::state' {
      technology 'Rust and serde'
      description 'Builds and serializes the validated repository state envelope.'
      link ../../src/state.rs 'source'
    }
    rustStatePublication = module 'criv::state::publication' {
      technology 'Rust'
      description 'Owns the publication transaction, recovery, index, latest pointer, and retention.'
      link ../../src/state/publication.rs 'source'
    }
    rustSnapshots = module 'criv::state::snapshots' {
      technology 'Rust and blake3'
      description 'Stores and reads immutable content-addressed state snapshots.'
      link ../../src/state/snapshots.rs 'source'
    }
  }

  extend criv.cli.knowledgeQueries {
    rustQuery = module 'criv::query' {
      technology 'Rust'
      description 'Answers typed knowledge graph questions about the vault.'
      link ../../src/query.rs 'source'
    }
  }

  // Command routing.
  criv.cli.commandInterface.rustMain -> criv.cli.commandInterface.rustCriv 'Calls the library API'
  criv.cli.commandInterface.rustCriv -> criv.cli.installation.rustInit 'Starts vault initialization'
  criv.cli.commandInterface.rustCriv -> criv.cli.installation.rustInstall 'Starts editor installation'
  criv.cli.commandInterface.rustCriv -> criv.cli.vaultModel.rustVault 'Runs one-shot load operations'
  criv.cli.commandInterface.rustCriv -> criv.cli.refreshCoordinator.rustWatch 'Starts watch sessions'
  criv.cli.commandInterface.rustCriv -> criv.cli.refreshCoordinator.rustRefresh 'Runs one-shot refresh sessions'
  criv.cli.commandInterface.rustCriv -> criv.cli.governanceEngine.rustCheck 'Runs one-shot checks'
  criv.cli.commandInterface.rustCriv -> criv.cli.governanceEngine.rustEnforce 'Runs staged enforcement'
  criv.cli.commandInterface.rustCriv -> criv.cli.knowledgeQueries.rustQuery 'Sends query requests'

  // Refresh pipeline.
  criv.cli.refreshCoordinator.rustWatch -> criv.cli.refreshCoordinator.rustRefresh 'Schedules refresh sessions'
  criv.cli.refreshCoordinator.rustWatch -> criv.cli.sourceIntelligence.rustDiscovery 'Classifies Source events'
  criv.cli.refreshCoordinator.rustWatch -> criv.cli.vaultModel.rustConfig 'Reads the watch configuration'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.vaultModel.rustVault 'Loads the repository model'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.vaultModel.rustConfig 'Reads the refresh configuration'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.sourceIntelligence.rustSource 'Refreshes or reuses one Source state'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.governanceEngine.rustCheck 'Validates the loaded vault'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.statePublisher.rustState 'Publishes the validated state'

  // Vault loading.
  criv.cli.vaultModel.rustVault -> criv.cli.architectureService.rustC4 'Loads C4 artifacts and workspaces'
  criv.cli.vaultModel.rustVault -> criv.cli.vaultModel.rustConfig 'Reads the vault configuration'
  criv.cli.vaultModel.rustVault -> criv.cli.diagnosticLocations.rustDiagnostic 'Keeps exact parsed document locations'
  criv.cli.architectureService.rustC4 -> criv.cli.architectureService.rustC4Artifact 'Classifies C4 artifacts'
  criv.cli.architectureService.rustC4 -> criv.cli.architectureService.rustLikeC4 'Compiles the LikeC4 workspace'
  criv.cli.architectureService.rustC4Artifact -> criv.cli.diagnosticLocations.rustDiagnostic 'Validates artifact byte spans'
  criv.cli.architectureService.rustLikeC4 -> criv.cli.diagnosticLocations.rustDiagnostic 'Converts LikeC4 LSP ranges'
  criv.cli.vaultModel.rustVault -> criv.cli.sourceIntelligence.rustSource 'Stores one completed Source state'

  // Source analysis.
  criv.cli.sourceIntelligence.rustSource -> criv.cli.sourceIntelligence.rustDiscovery 'Selects Source candidates'
  criv.cli.sourceIntelligence.rustSource -> criv.cli.sourceIntelligence.rustSourceCatalog 'Owns stable Source paths'
  criv.cli.sourceIntelligence.rustSource -> criv.cli.sourceIntelligence.rustSourceGraph 'Builds and reuses the parsed graph'
  criv.cli.sourceIntelligence.rustSource -> criv.cli.sourceIntelligence.rustSourcePaths 'Owns Source text conversion'
  criv.cli.sourceIntelligence.rustDiscovery -> criv.cli.vaultModel.rustConfig 'Reads file-selection rules'
  criv.cli.sourceIntelligence.rustStructural -> criv.cli.sourceIntelligence.rustSource 'Reads selected Source text'
  criv.cli.sourceIntelligence.rustSourceGraph -> criv.cli.sourceIntelligence.rustSourcePaths 'Reads selected source content'
  criv.cli.sourceIntelligence.rustStructural -> criv.cli.diagnosticLocations.rustDiagnostic 'Keeps exact match byte spans'

  // Repository file access.
  criv.cli.repositoryFiles.rustRepository -> criv.cli.repositoryFiles.rustRepositoryFilesystem 'Uses the private operating-system implementation'
  criv.cli.vaultModel.rustConfig -> criv.cli.repositoryFiles.rustRepository 'Reads repository configuration'
  criv.cli.vaultModel.rustVault -> criv.cli.repositoryFiles.rustRepository 'Reads selected vault files'
  criv.cli.sourceIntelligence.rustDiscovery -> criv.cli.repositoryFiles.rustRepository 'Reads selected files'
  criv.cli.sourceIntelligence.rustSourcePaths -> criv.cli.repositoryFiles.rustRepository 'Reads selected Source bytes'
  criv.cli.sourceIntelligence.rustSourceGraph -> criv.cli.repositoryFiles.rustRepository 'Reads Source bytes and publishes its cache'
  criv.cli.sourceIntelligence.rustStructural -> criv.cli.repositoryFiles.rustRepository 'Reads selected Source text'
  criv.cli.installation.rustInit -> criv.cli.repositoryFiles.rustRepository 'Writes the vault scaffold'
  criv.cli.installation.rustInstallSkills -> criv.cli.repositoryFiles.rustRepository 'Publishes and inspects generated skills'
  criv.cli.refreshCoordinator.rustWatch -> criv.cli.repositoryFiles.rustRepository 'Keeps the watch lock and generation handle'
  criv.cli.refreshCoordinator.rustRefresh -> criv.cli.repositoryFiles.rustRepository 'Keeps one refresh handle'
  criv.cli.governanceEngine.rustCheck -> criv.cli.repositoryFiles.rustRepository 'Reads and fixes checked files'
  criv.cli.governanceEngine.rustAdr -> criv.cli.repositoryFiles.rustRepository 'Writes ADR reconciliation files'
  criv.cli.governanceEngine.rustSourceReconcile -> criv.cli.repositoryFiles.rustRepository 'Writes source reconciliation files'
  criv.cli.governanceEngine.rustReconcileTransaction -> criv.cli.repositoryFiles.rustRepository 'Captures and restores worktree files'
  criv.cli.repositoryHistory.rustGit -> criv.cli.repositoryFiles.rustRepository 'Captures and restores raw Git index bytes'
  criv.cli.statePublisher.rustStatePublication -> criv.cli.repositoryFiles.rustRepository 'Publishes and recovers State transactions'
  criv.cli.statePublisher.rustSnapshots -> criv.cli.repositoryFiles.rustRepository 'Reads and retains snapshots'

  // Validation and enforcement.
  criv.cli.governanceEngine.rustCheck -> criv.cli.vaultModel.rustVault 'Validates repository artifacts'
  criv.cli.governanceEngine.rustCheck -> criv.cli.architectureService.rustC4 'Validates C4 artifacts'
  criv.cli.governanceEngine.rustCheck -> criv.cli.vaultModel.rustConfig 'Reads the check configuration'
  criv.cli.governanceEngine.rustCheck -> criv.cli.governanceEngine.rustPolicyScan 'Evaluates policy patterns'
  criv.cli.governanceEngine.rustCheck -> criv.cli.repositoryHistory.rustGit 'Reads changed files and history'
  criv.cli.governanceEngine.rustCheck -> criv.cli.statePublisher.rustState 'Reads the previous published state'
  criv.cli.governanceEngine.rustCheck -> criv.cli.installation.rustInstall 'Checks the generated skill inventory'
  criv.cli.governanceEngine.rustCheck -> criv.cli.diagnosticLocations.rustDiagnostic 'Converts exact command output locations'
  criv.cli.governanceEngine.rustPolicyScan -> criv.cli.sourceIntelligence.rustStructural 'Matches structural patterns'
  criv.cli.governanceEngine.rustPolicyScan -> criv.cli.vaultModel.rustVault 'Reads scanned vault content'
  criv.cli.governanceEngine.rustPolicyScan -> criv.cli.diagnosticLocations.rustDiagnostic 'Carries exact violation locations'
  criv.cli.governanceEngine.rustAdr -> criv.cli.vaultModel.rustVault 'Reads decisions'
  criv.cli.governanceEngine.rustAdr -> criv.cli.vaultModel.rustConfig 'Reads the decision configuration'
  criv.cli.governanceEngine.rustAdr -> criv.cli.repositoryHistory.rustGit 'Reads decision history'
  criv.cli.governanceEngine.rustAdr -> criv.cli.governanceEngine.rustSourceReconcile 'Reconciles governed source scopes'
  criv.cli.governanceEngine.rustAdr -> criv.cli.governanceEngine.rustReconcileTransaction 'Captures rollback state'
  criv.cli.governanceEngine.rustSourceReconcile -> criv.cli.repositoryHistory.rustGit 'Reads renames and deletions'
  criv.cli.governanceEngine.rustSourceReconcile -> criv.cli.vaultModel.rustVault 'Reads governed source references'
  criv.cli.governanceEngine.rustSourceReconcile -> criv.cli.governanceEngine.rustReconcileTransaction 'Captures rollback state'
  criv.cli.governanceEngine.rustReconcileTransaction -> criv.cli.repositoryHistory.rustGit 'Restores the Git index'
  criv.cli.governanceEngine.rustEnforce -> criv.cli.governanceEngine.rustCheck 'Runs the staged checks'
  criv.cli.governanceEngine.rustEnforce -> criv.cli.governanceEngine.rustPolicyScan 'Runs the staged policy scan'
  criv.cli.governanceEngine.rustEnforce -> criv.cli.governanceEngine.rustAdr 'Reads effective governance'
  criv.cli.governanceEngine.rustEnforce -> criv.cli.repositoryHistory.rustGit 'Selects the staged change scope'
  criv.cli.governanceEngine.rustEnforce -> criv.cli.vaultModel.rustVault 'Loads the changed vault scope'

  // State publication.
  criv.cli.statePublisher.rustState -> criv.cli.vaultModel.rustVault 'Builds the state envelope'
  criv.cli.statePublisher.rustState -> criv.cli.architectureService.rustC4 'Serializes C4 artifacts'
  criv.cli.statePublisher.rustState -> criv.cli.sourceIntelligence.rustSource 'Serializes source relations'
  criv.cli.statePublisher.rustState -> criv.cli.sourceIntelligence.rustStructural 'Serializes structural matches'
  criv.cli.statePublisher.rustState -> criv.cli.statePublisher.rustStatePublication 'Publishes validated State'
  criv.cli.statePublisher.rustStatePublication -> criv.cli.statePublisher.rustSnapshots 'Stores retained snapshots'

  // Queries.
  criv.cli.knowledgeQueries.rustQuery -> criv.cli.vaultModel.rustVault 'Resolves graph questions'
  criv.cli.knowledgeQueries.rustQuery -> criv.cli.sourceIntelligence.rustSource 'Reads Source identities and kinds'
  criv.cli.knowledgeQueries.rustQuery -> criv.cli.repositoryHistory.rustGit 'Reads commit history'
  criv.cli.knowledgeQueries.rustQuery -> criv.cli.statePublisher.rustStatePublication 'Reads published snapshots'
  // Vault initialization.
  criv.cli.installation.rustInit -> criv.cli.installation.rustInstall 'Installs the skill inventory'
  criv.cli.installation.rustInstall -> criv.cli.installation.rustInstallSkills 'Installs and inspects generated skills'
  criv.cli.installation.rustInstall -> criv.cli.installation.rustInstallEditor 'Installs the bundled editor viewer'
}

views {
  global style architectureTheme

  view codeRefreshPipeline of criv.cli.refreshCoordinator {
    title 'Code / CLI / Refresh pipeline'
    description 'The Rust modules that run one refresh session.'

    include *
    include criv.cli.vaultModel.rustVault
    include criv.cli.sourceIntelligence.rustSource
    include criv.cli.sourceIntelligence.rustSourceCatalog
    include criv.cli.sourceIntelligence.rustDiscovery
    include criv.cli.sourceIntelligence.rustSourceGraph
    include criv.cli.sourceIntelligence.rustSourcePaths
    include criv.cli.governanceEngine.rustCheck
    include criv.cli.architectureService.*
    include criv.cli.statePublisher.rustState
  }

  view codeSourceState of criv.cli.sourceIntelligence {
    title 'Code / CLI / Source state'
    description 'The Source state interface, its private implementations, and its lifecycle callers.'

    include criv.cli.sourceIntelligence.rustSource
    include criv.cli.sourceIntelligence.rustSourceCatalog
    include criv.cli.sourceIntelligence.rustSourceGraph
    include criv.cli.sourceIntelligence.rustDiscovery
    include criv.cli.refreshCoordinator.rustRefresh
    include criv.cli.vaultModel.rustVault
    include criv.cli.statePublisher.rustState
    include criv.cli.knowledgeQueries.rustQuery
  }

  view codeRepositoryFiles of criv.cli.repositoryFiles {
    title 'Code / CLI / Repository files'
    description 'The parent repository interface, its private implementation, and the owners that keep one handle for complete operations.'

    include *
    include criv.cli.vaultModel.rustVault
    include criv.cli.sourceIntelligence.rustSourceGraph
    include criv.cli.installation.rustInit
    include criv.cli.refreshCoordinator.rustWatch
    include criv.cli.governanceEngine.rustAdr
    include criv.cli.governanceEngine.rustReconcileTransaction
    include criv.cli.repositoryHistory.rustGit
    include criv.cli.statePublisher.rustStatePublication
  }

  view codeInstallation of criv.cli.installation {
    title 'Code / CLI / Installation'
    description 'The parent installation interface and its separate skill and editor implementations.'

    include *
    include criv.cli.commandInterface.rustCriv
    include criv.cli.governanceEngine.rustCheck
  }

  view codeDiagnosticLocations of criv.cli.diagnosticLocations {
    title 'Code / CLI / Diagnostic locations'
    description 'The shared location conversion and its exact-range producers and output consumer.'

    include *
    include criv.cli.governanceEngine.rustCheck
    include criv.cli.governanceEngine.rustPolicyScan
    include criv.cli.vaultModel.rustVault
    include criv.cli.architectureService.rustC4Artifact
    include criv.cli.architectureService.rustLikeC4
    include criv.cli.sourceIntelligence.rustStructural
  }

  view codeValidation of criv.cli.governanceEngine {
    title 'Code / CLI / Validation and enforcement'
    description 'The Rust modules that validate the vault and gate each enforcement stage.'

    include *
    include criv.cli.repositoryHistory.*
    include criv.cli.vaultModel.rustVault
    include criv.cli.vaultModel.rustConfig
    include criv.cli.sourceIntelligence.rustStructural
    include criv.cli.installation.rustInstall
  }

  view codeVaultLoading of criv.cli.vaultModel {
    title 'Code / CLI / Vault loading'
    description 'The Rust modules that build the repository vault.'

    include *
    include criv.cli.architectureService.*
    include criv.cli.sourceIntelligence.rustSource
    include criv.cli.sourceIntelligence.rustSourceCatalog
    include criv.cli.sourceIntelligence.rustDiscovery
    include criv.cli.sourceIntelligence.rustSourceGraph
    include criv.cli.diagnosticLocations.rustDiagnostic
  }

  view codeQuery of criv.cli.knowledgeQueries {
    title 'Code / CLI / Queries'
    description 'The Rust modules that answer typed knowledge graph questions.'

    include *
    include criv.cli.vaultModel.rustVault
    include criv.cli.sourceIntelligence.*
    include criv.cli.repositoryHistory.*
    include criv.cli.statePublisher.rustSnapshots
  }

  view codeArchitectureExporter of criv.cli.architectureService {
    title 'Code / CLI / C4 service'
    description 'The C4 interface and its sibling artifact and LikeC4 implementations.'

    include *
    include criv.cli.vaultModel.rustVault
    include criv.cli.vaultModel.rustConfig
    include criv.cli.diagnosticLocations.rustDiagnostic
  }

  view codeStatePublication of criv.cli.statePublisher {
    title 'Code / CLI / State publication'
    description 'The Rust modules that build and retain the state envelope.'

    include *
    include criv.cli.vaultModel.rustVault
    include criv.cli.architectureService.rustC4
    include criv.cli.sourceIntelligence.rustSource
    include criv.cli.sourceIntelligence.rustStructural
  }
}
