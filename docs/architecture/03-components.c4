C4Component
title Component diagram for criv architecture and validation workflow
Person(maintainer, "Repository maintainer", "Runs criv and reviews text-first architecture artifacts")
System_Ext(obsidian, "Obsidian", "Hosts the criv companion plugin")
ContainerDb(vault, "Repository vault", "Markdown, .c4, TOML, source files, and JSON state", "Stores docs, ADRs, source, standalone C4 artifacts, and generated criv state")
Container_Boundary(cli_boundary, "criv CLI") {
    Component(cli_dispatch, "CLI dispatch", "Rust and clap", "Parses commands and routes init, check, query, search, watch, and enforce workflows")
    %% criv:source src/lib.rs
    Component(vault_loader, "Vault loader", "Rust", "Loads config, notes, ADR metadata, wiki-links, source files, C4 artifacts, and source graph data")
    %% criv:source src/vault.rs
    Component(c4_parser, "C4 artifact parser", "Rust", "Infers .c4 format and level, parses Mermaid C4 files, and records artifact diagnostics")
    %% criv:source src/c4_artifact.rs
    Component(source_graph, "Source graph", "Rust and tree-sitter", "Extracts files, symbols, imports, calls, and interface signatures for drift checks")
    %% criv:source src/source_graph.rs
    Component(validator, "Validation engine", "Rust", "Checks docs, links, C4 diagrams, .c4 files, source anchors, interface drift, ADRs, and policies")
    %% criv:source src/check.rs
    Component(architecture_generator, "Architecture generator", "Rust", "Writes generated Code-level DOT architecture into standalone .c4 output")
    %% criv:source src/architecture.rs
    Component(state_writer, "State writer", "Rust and serde_json", "Serializes graph nodes, .c4 artifacts, C4 diagrams, source indexes, pattern matches, and snapshots")
    %% criv:source src/state.rs
    Component(watcher, "Watch loop", "Rust and notify", "Refreshes generated architecture and state after source or docs changes")
    %% criv:source src/watch.rs
}
Container_Boundary(plugin_boundary, "Obsidian companion plugin") {
    Component(plugin_runtime, "Plugin runtime", "TypeScript and Obsidian API", "Registers commands, source panels, hover previews, editor suggestions, and the .c4 file view")
    %% criv:source .obsidian/plugins/criv/src/main.ts
    Component(c4_view, ".c4 file view", "TypeScript", "Shows source text, parsed metadata, diagnostics, and a rendered projection for standalone C4 artifacts")
    %% criv:source .obsidian/plugins/criv/src/main.ts#type:CrivC4View
    Component(c4_view_helpers, "C4 view helpers", "TypeScript", "Infers .c4 format and level for the editor view and reports lightweight diagnostics")
    %% criv:source .obsidian/plugins/criv/src/core.ts#fn:parseC4Artifact
    Component(mermaid_renderer, "Mermaid projection renderer", "TypeScript and Mermaid.js", "Renders Mermaid-backed .c4 files inside Obsidian while leaving text as the source of truth")
    %% criv:source .obsidian/plugins/criv/src/main.ts#fn:renderC4Projection
    Component(wasm_helper, "criv-wasm helper", "Rust compiled to WebAssembly", "Summarizes generated criv state for plugin status and compatibility checks")
    %% criv:source crates/criv-wasm/src/lib.rs
}
Rel(maintainer, cli_dispatch, "runs local commands through")
Rel(cli_dispatch, vault_loader, "loads repository state with")
Rel(vault_loader, c4_parser, "parses standalone .c4 artifacts with")
Rel(vault_loader, source_graph, "builds code graph and interface signatures with")
Rel(validator, vault_loader, "checks loaded vault content from")
Rel(validator, source_graph, "verifies source anchors and interface drift against")
Rel(architecture_generator, source_graph, "generates Code-level architecture from")
Rel(watcher, architecture_generator, "refreshes generated architecture through")
Rel(watcher, state_writer, "writes refreshed state through")
Rel(state_writer, vault, "writes .criv/state.json into")
Rel(architecture_generator, vault, "writes docs/architecture/04-code.c4 into")
Rel(obsidian, plugin_runtime, "loads")
Rel(plugin_runtime, c4_view, "opens .c4 files with")
Rel(c4_view, c4_view_helpers, "parses metadata through")
Rel(c4_view, mermaid_renderer, "renders Mermaid projections through")
Rel(plugin_runtime, wasm_helper, "summarizes generated state through")
Rel(plugin_runtime, vault, "reads .c4 files, state, and source previews from")
