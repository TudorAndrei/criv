specification {
  element person {
    style { shape person }
  }
  element softwareSystem
  element container
  element component {
    style { shape component }
  }
  element dataStore {
    style { shape storage }
  }
}

model {
  maintainer = person 'Repository maintainer' {
    description 'Writes source code, documentation, decisions, policy, and architecture.'
    link ../../README.md 'source'
  }

  criv = softwareSystem 'criv' {
    description 'Local documentation-to-code knowledge graph validator and editor companion.'
    link ../../src/lib.rs 'source'

    cli = container 'criv CLI' {
      technology 'Rust'
      description 'Validates the vault, generates architecture and state, and runs queries.'
      link ../../src/lib.rs 'source'

      vaultLoader = component 'Vault loader' {
        link ../../src/vault.rs 'source'
      }
      likec4Bridge = component 'LikeC4 bridge' {
        link ../../src/likec4.rs 'source'
      }
      sourceGraph = component 'Source graph' {
        link ../../src/source_graph.rs 'source'
      }
      validator = component 'Validation engine' {
        link ../../src/check.rs 'source'
      }
      architectureGenerator = component 'Module architecture generator' {
        link ../../src/architecture.rs 'source'
      }
      stateWriter = component 'State writer' {
        link ../../src/state.rs 'source'
      }
    }

    renderer = container 'Shared LikeC4 renderer' {
      technology 'TypeScript, React, LikeC4'
      link ../../packages/criv-likec4/src/renderer.ts 'source'
    }
    obsidianPlugin = container 'Obsidian companion plugin' {
      technology 'TypeScript and WebAssembly'
      link ../../.obsidian/plugins/criv/src/main.ts 'source'
    }
    vscodeExtension = container 'VS Code companion extension' {
      technology 'TypeScript and WebAssembly'
      link ../../extensions/vscode-criv/src/extension.ts 'source'
    }
    vault = dataStore 'Repository vault' {
      description 'Stores source, documents, LikeC4 DSL, configuration, and generated state.'
      link ../../criv.toml 'source'
    }
  }

  git = softwareSystem 'Git'
  obsidian = softwareSystem 'Obsidian'
  vscode = softwareSystem 'VS Code-compatible editor'
  githubActions = softwareSystem 'GitHub Actions'

  maintainer -> criv 'Runs and reviews'
  criv.cli -> criv.vault 'Reads and writes'
  criv.cli -> git 'Reads repository history'
  criv.obsidianPlugin -> criv.renderer 'Uses'
  criv.vscodeExtension -> criv.renderer 'Uses'
  obsidian -> criv.obsidianPlugin 'Hosts'
  vscode -> criv.vscodeExtension 'Hosts'
  githubActions -> criv.cli 'Runs checks'
  criv.obsidianPlugin -> criv.vault 'Reads files and state'
  criv.vscodeExtension -> criv.vault 'Reads files and state'
  criv.cli.vaultLoader -> criv.cli.sourceGraph 'Builds'
  criv.cli.validator -> criv.cli.vaultLoader 'Validates'
  criv.cli.validator -> criv.cli.likec4Bridge 'Uses'
  criv.cli.architectureGenerator -> criv.cli.sourceGraph 'Reads modules from'
  criv.cli.stateWriter -> criv.vault 'Publishes state to'
}

views {
  view context {
    title 'criv system context'
    include maintainer
    include criv
    include git
    include obsidian
    include vscode
    include githubActions
    include * -> *
  }
}
