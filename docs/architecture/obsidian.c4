model {
  extend criv {
    obsidianPlugin = container 'Obsidian companion plugin' {
      technology 'TypeScript and Obsidian API'
      description 'Shows state, source references, policy matches, and LikeC4 previews inside Obsidian.'
      link ../../.obsidian/plugins/criv/src/main.ts 'source'

      obsidianController = component 'Plugin composition' {
        technology 'TypeScript and Obsidian plugin API'
        description 'Constructs lifecycle owners, registers their Obsidian surfaces, and shuts them down in order.'
        link ../../.obsidian/plugins/criv/src/main.ts 'source'
      }
      obsidianStateOwner = component 'State lifecycle' {
        technology 'TypeScript and Obsidian file API'
        description 'Loads one validated State revision, polls its file token, and publishes status generations.'
        link ../../.obsidian/plugins/criv/src/state/owner.ts 'source'
      }
      obsidianC4View = component 'C4 view lifecycle' {
        technology 'TypeScript, Obsidian FileView, and React'
        description 'Owns C4 source editing, preview generations, named-view selection, navigation, and renderer disposal.'
        link ../../.obsidian/plugins/criv/src/c4-view.ts 'source'
      }
      obsidianSourcePanel = component 'Source panel' {
        technology 'TypeScript and Obsidian ItemView'
        description 'Owns the singleton panel that shows source links and policy matches for the active note.'
        link ../../.obsidian/plugins/criv/src/source/panel.ts 'source'
      }
      obsidianSourceReferences = component 'Source reference editor' {
        technology 'TypeScript, Obsidian editor API, and CodeMirror'
        description 'Owns source suggestions, Markdown link decoration, hover previews, and editor drift marks.'
        link ../../.obsidian/plugins/criv/src/source/references.ts 'source'
      }
      obsidianSourcePreview = component 'Source preview renderer' {
        technology 'TypeScript and DOM'
        description 'Reads confined source excerpts and renders lifecycle-free highlighted previews.'
        link ../../.obsidian/plugins/criv/src/source/preview.ts 'source'
      }
      obsidianSettings = component 'Settings lifecycle' {
        technology 'TypeScript and Obsidian settings API'
        description 'Loads, persists, and presents the State path and external editor settings.'
        link ../../.obsidian/plugins/criv/src/settings.ts 'source'
      }
      obsidianState = component 'Source model' {
        technology 'TypeScript'
        description 'Defines validated state data and pure navigation and presentation operations.'
        link ../../.obsidian/plugins/criv/src/source/model.ts 'source'
      }
      obsidianWasm = component 'WebAssembly adapter' {
        technology 'TypeScript'
        description 'Loads, calls, and disposes revisions from the packaged state projection library.'
        link ../../.obsidian/plugins/criv/src/state/wasm.ts 'source'
      }
    }
  }
}

views {
  global style architectureTheme

  view obsidianComponents of criv.obsidianPlugin {
    title 'Components / Obsidian'
    description 'How lifecycle owners connect Obsidian surfaces to State, source references, and architecture previews.'

    include *
    include criv.stateStore
    include criv.stateProjection
    include criv.sharedRenderer
    include
      criv.obsidianPlugin.obsidianController with {
        navigateTo codeObsidianAdapter
      }
  }
}
