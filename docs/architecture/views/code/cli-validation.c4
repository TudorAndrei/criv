views {
  view codeValidation of criv.cli.validator {
    title 'Code / CLI / Validation and enforcement'
    description 'The Rust modules that validate the vault and gate each enforcement stage.'

    include *
    include criv.cli.enforcementGateway.*
    include criv.cli.gitAccess.*
    include criv.cli.vaultLoader.*
    include criv.cli.sourceAnalysis.rustStructural
  }
}
