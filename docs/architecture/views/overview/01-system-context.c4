views {
  view index {
    title 'Overview / System context'
    description 'Who uses criv, and which external systems criv works with.'

    include maintainer
    include criv with {
      navigateTo containers
    }
    include repository
    include obsidian
    include vscode
    include githubActions

    style * {
      color primary
    }
    style element.tag = #external {
      color muted
    }
    style maintainer {
      color green
    }
  }
}
