views {
  view vscodeComponents of criv.vscodeExtension {
    title 'Components / VS Code'
    description 'How the VS Code extension runs criv, shows diagnostics, and draws C4 previews.'

    include *
    include criv.vscodeExtension.vscodePreview with {
      navigateTo codeVscodePreview
    }
    include criv.vscodeExtension.vscodeState with {
      navigateTo codeVscodeState
    }

    style element.tag = #external {
      color muted
    }
  }
}
