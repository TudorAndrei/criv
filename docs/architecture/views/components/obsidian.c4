views {
  view obsidianComponents of criv.obsidianPlugin {
    title 'Components / Obsidian'
    description 'How the Obsidian plugin reads criv state and draws C4 previews.'

    include *
    include criv.obsidianPlugin.obsidianController with {
      navigateTo codeObsidianAdapter
    }

    style element.tag = #external {
      color muted
    }
  }
}
