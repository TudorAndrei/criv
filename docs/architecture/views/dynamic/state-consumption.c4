views {
  dynamic view stateConsumption {
    title 'Dynamic / Editors / Opening a C4 preview'
    description 'The order of events when a maintainer opens a C4 file in VS Code.'

    maintainer -> criv.vscodeExtension.vscodeController 'Opens a .c4 file'
    criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodePreview 'Opens the custom editor'
    criv.vscodeExtension.vscodePreview -> criv.vscodeExtension.vscodeState 'Requests the compiled model'
    criv.vscodeExtension.vscodeState -> criv.stateStore 'Reads the published state'
    criv.stateStore -> criv.vscodeExtension.vscodeState 'Returns the state envelope'
    criv.vscodeExtension.vscodeState -> criv.vscodeExtension.vscodePreview 'Returns the compiled C4 model'
    criv.vscodeExtension.vscodePreview -> criv.sharedRenderer.diagramRenderer 'Mounts the selected view'
    criv.sharedRenderer.diagramRenderer -> criv.vscodeExtension.vscodePreview 'Reports the navigated view'
  }
}
