C4Container
title Container diagram for criv
Person(maintainer, "Repository maintainer", "Runs local CLI commands and edits repository files")
System_Ext(git, "Git", "Runs configured hooks and exposes repository history")
System_Ext(obsidian, "Obsidian", "Hosts the companion plugin inside the local vault")
System_Ext(vscode, "VS Code-compatible editors", "Host the companion extension in VS Code, Cursor, and compatible local editors")
System_Boundary(criv_system, "criv") {
    Container(cli, "criv CLI", "Rust binary", "Initializes vaults, validates docs and source links, generates architecture/state, answers queries, searches content, watches changes, and enforces policy")
    %% criv:source src/lib.rs
    Container(plugin, "Obsidian companion plugin", "TypeScript plugin with Rust/WASM helper and bundled Mermaid.js", "Opens .c4 artifacts, renders Mermaid projections, previews source references, and reads generated criv state")
    %% criv:source .obsidian/plugins/criv/src/main.ts
    Container(vscode_extension, "VS Code-compatible companion extension", "TypeScript extension with Rust/WASM helper, Mermaid.js, and Viz.js", "Reads generated criv state, navigates source selectors, surfaces checks, and renders .c4 artifacts in VS Code-compatible editors")
    %% criv:source extensions/vscode-criv/src/extension.ts
    ContainerDb(vault, "Repository vault", "Markdown, .c4, TOML, source files, and JSON state", "Stores docs, ADRs, configuration, source files, policy patterns, standalone C4 artifacts, and generated .criv state")
    %% criv:source criv.toml
}
Rel(maintainer, cli, "runs shell commands against a local checkout")
Rel(maintainer, vault, "edits source, docs, ADRs, policy files, and .c4 architecture files")
Rel(cli, vault, "reads repository content and writes .criv/state.json plus generated architecture")
Rel(cli, git, "installs hooks and enforces stage-aware repository policy")
Rel(obsidian, plugin, "loads and invokes through the editor API")
Rel(vscode, vscode_extension, "loads and invokes through the VS Code extension API")
Rel(plugin, vault, "reads .c4 files, .criv/state.json, and referenced source files")
Rel(vscode_extension, vault, "reads .c4 files, .criv/state.json, and referenced source files")
