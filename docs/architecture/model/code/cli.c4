// Code architecture for the criv CLI. Every node is a Rust module, and every
// relation is an import relation between modules. `criv::util` is a
// cross-cutting helper module and stays outside the architecture.
model {
  extend criv.cli.commandRouter {
    rustMain = module 'criv::main' {
      technology 'Rust'
      description 'Parses command-line arguments and reports process results.'
      link ../../src/main.rs 'source'
    }
    rustCriv = module 'criv' {
      technology 'Rust'
      description 'Exposes the library API and routes each operation to its workflow.'
      link ../../src/lib.rs 'source'
    }
  }

  extend criv.cli.initializer {
    rustInit = module 'criv::init' {
      technology 'Rust'
      description 'Writes the vault scaffold and canonical configuration.'
      link ../../src/init.rs 'source'
    }
    rustGeneratedSkills = module 'criv::generated_skills' {
      technology 'Rust'
      description 'Installs and inspects the canonical generated skill inventory.'
      link ../../src/generated_skills.rs 'source'
    }
  }

  extend criv.cli.vaultLoader {
    rustVault = module 'criv::vault' {
      technology 'Rust'
      description 'Builds the in-memory repository vault from documents and source data.'
      link ../../src/vault.rs 'source'
    }
    rustC4 = module 'criv::c4' {
      technology 'Rust'
      description 'Defines C4 artifact data and source handling.'
      link ../../src/c4.rs 'source'
    }
    rustConfig = module 'criv::config' {
      technology 'Rust'
      description 'Reads and validates the canonical criv configuration.'
      link ../../src/config.rs 'source'
    }
  }

  extend criv.cli.gitAccess {
    rustGit = module 'criv::git' {
      technology 'Rust and git2'
      description 'Holds the embedded Git boundary for repository history and change sets.'
      link ../../src/git.rs 'source'
    }
  }

  extend criv.cli.likec4Compiler {
    rustLikeC4 = module 'criv::likec4' {
      technology 'Rust'
      description 'Runs the LikeC4 bridge and returns models and diagnostics.'
      link ../../src/likec4.rs 'source'
    }
  }

  extend criv.cli.sourceAnalysis {
    rustSourceIndex = module 'criv::source_index' {
      technology 'Rust'
      description 'Indexes repository source paths for one-shot and live workflows.'
      link ../../src/source_index.rs 'source'
    }
    rustSourcePaths = module 'criv::source_paths' {
      technology 'Rust'
      description 'Selects and reads source paths from configured roots.'
      link ../../src/source_paths.rs 'source'
    }
    rustSourceGraph = module 'criv::source_graph' {
      technology 'Rust and tree-sitter'
      description 'Extracts language modules, imports, and symbols from indexed sources.'
      link ../../src/source_graph.rs 'source'
    }
    rustStructural = module 'criv::structural' {
      technology 'Rust and ast-grep'
      description 'Matches structural patterns against parsed source files.'
      link ../../src/structural.rs 'source'
    }
  }

  extend criv.cli.validator {
    rustCheck = module 'criv::check' {
      technology 'Rust'
      description 'Validates the loaded vault and produces structured diagnostics.'
      link ../../src/check.rs 'source'
    }
    rustPolicyScan = module 'criv::policy_scan' {
      technology 'Rust'
      description 'Evaluates configured policy patterns against repository content.'
      link ../../src/policy_scan.rs 'source'
    }
    rustAdr = module 'criv::adr' {
      technology 'Rust'
      description 'Resolves effective decision governance for each source scope.'
      link ../../src/adr.rs 'source'
    }
    rustSourceReconcile = module 'criv::source_reconcile' {
      technology 'Rust'
      description 'Reconciles renamed and deleted source scopes against decisions.'
      link ../../src/source_reconcile.rs 'source'
    }
  }

  extend criv.cli.enforcementGateway {
    rustEnforce = module 'criv::enforce' {
      technology 'Rust'
      description 'Selects the change scope for each enforcement stage and fails closed.'
      link ../../src/enforce.rs 'source'
    }
  }

  extend criv.cli.refreshPipeline {
    rustWatch = module 'criv::watch' {
      technology 'Rust and notify'
      description 'Receives file changes and schedules incremental refresh sessions.'
      link ../../src/watch.rs 'source'
    }
    rustRefresh = module 'criv::refresh' {
      technology 'Rust'
      description 'Coordinates load, validation, architecture output, and state publication.'
      link ../../src/refresh.rs 'source'
    }
  }

  extend criv.cli.statePublisher {
    rustState = module 'criv::state' {
      technology 'Rust and serde'
      description 'Builds and serializes the validated repository state envelope.'
      link ../../src/state.rs 'source'
    }
    rustSnapshots = module 'criv::snapshots' {
      technology 'Rust and blake3'
      description 'Publishes and retains immutable content-addressed state snapshots.'
      link ../../src/snapshots.rs 'source'
    }
  }

  extend criv.cli.queryEngine {
    rustQuery = module 'criv::query' {
      technology 'Rust'
      description 'Answers typed knowledge graph questions about the vault.'
      link ../../src/query.rs 'source'
    }
    rustSearch = module 'criv::search' {
      technology 'Rust'
      description 'Runs text and structural searches over indexed sources.'
      link ../../src/search.rs 'source'
    }
  }

  extend criv.cli.architectureExporter {
    rustArchitecture = module 'criv::architecture' {
      technology 'Rust'
      description 'Controls optional publication of generated Code architecture.'
      link ../../src/architecture.rs 'source'
    }
    rustC4Code = module 'criv::c4_code' {
      technology 'Rust and LikeC4'
      description 'Serializes an indexed module graph as LikeC4 source.'
      link ../../src/c4_code.rs 'source'
    }
  }

  // Command routing.
  criv.cli.commandRouter.rustMain -> criv.cli.commandRouter.rustCriv 'Calls the library API'
  criv.cli.commandRouter.rustCriv -> criv.cli.initializer.rustInit 'Installs the vault scaffold'
  criv.cli.commandRouter.rustCriv -> criv.cli.vaultLoader.rustVault 'Runs one-shot load operations'
  criv.cli.commandRouter.rustCriv -> criv.cli.refreshPipeline.rustWatch 'Starts watch sessions'
  criv.cli.commandRouter.rustCriv -> criv.cli.refreshPipeline.rustRefresh 'Runs one-shot refresh sessions'
  criv.cli.commandRouter.rustCriv -> criv.cli.validator.rustCheck 'Runs one-shot checks'
  criv.cli.commandRouter.rustCriv -> criv.cli.enforcementGateway.rustEnforce 'Runs staged enforcement'
  criv.cli.commandRouter.rustCriv -> criv.cli.queryEngine.rustQuery 'Sends query requests'
  criv.cli.commandRouter.rustCriv -> criv.cli.queryEngine.rustSearch 'Sends search requests'

  // Refresh pipeline.
  criv.cli.refreshPipeline.rustWatch -> criv.cli.refreshPipeline.rustRefresh 'Schedules refresh sessions'
  criv.cli.refreshPipeline.rustWatch -> criv.cli.sourceAnalysis.rustSourceIndex 'Updates the live source index'
  criv.cli.refreshPipeline.rustWatch -> criv.cli.vaultLoader.rustConfig 'Reads the watch configuration'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.vaultLoader.rustVault 'Loads the repository model'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.vaultLoader.rustConfig 'Reads the refresh configuration'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.sourceAnalysis.rustSourceIndex 'Updates the live source index'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.sourceAnalysis.rustSourceGraph 'Rebuilds changed source relations'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.validator.rustCheck 'Validates the loaded vault'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.architectureExporter.rustArchitecture 'Requests configured architecture output'
  criv.cli.refreshPipeline.rustRefresh -> criv.cli.statePublisher.rustState 'Publishes the validated state'

  // Vault loading.
  criv.cli.vaultLoader.rustVault -> criv.cli.vaultLoader.rustC4 'Creates C4 artifacts'
  criv.cli.vaultLoader.rustVault -> criv.cli.vaultLoader.rustConfig 'Reads the vault configuration'
  criv.cli.vaultLoader.rustVault -> criv.cli.likec4Compiler.rustLikeC4 'Compiles C4 sources'
  criv.cli.vaultLoader.rustVault -> criv.cli.sourceAnalysis.rustSourceIndex 'Indexes configured sources'
  criv.cli.vaultLoader.rustVault -> criv.cli.sourceAnalysis.rustSourceGraph 'Builds module and import relations'

  // Source analysis.
  criv.cli.sourceAnalysis.rustSourceIndex -> criv.cli.sourceAnalysis.rustSourcePaths 'Selects and reads source paths'
  criv.cli.sourceAnalysis.rustSourceIndex -> criv.cli.vaultLoader.rustConfig 'Reads the configured source roots'
  criv.cli.sourceAnalysis.rustSourceGraph -> criv.cli.sourceAnalysis.rustSourcePaths 'Reads indexed source content'

  // Validation and enforcement.
  criv.cli.validator.rustCheck -> criv.cli.vaultLoader.rustVault 'Validates repository artifacts'
  criv.cli.validator.rustCheck -> criv.cli.vaultLoader.rustC4 'Validates C4 artifacts'
  criv.cli.validator.rustCheck -> criv.cli.vaultLoader.rustConfig 'Reads the check configuration'
  criv.cli.validator.rustCheck -> criv.cli.validator.rustPolicyScan 'Evaluates policy patterns'
  criv.cli.validator.rustCheck -> criv.cli.gitAccess.rustGit 'Reads changed files and history'
  criv.cli.validator.rustCheck -> criv.cli.statePublisher.rustState 'Reads the previous published state'
  criv.cli.validator.rustCheck -> criv.cli.initializer.rustGeneratedSkills 'Checks the generated skill inventory'
  criv.cli.validator.rustPolicyScan -> criv.cli.sourceAnalysis.rustStructural 'Matches structural patterns'
  criv.cli.validator.rustPolicyScan -> criv.cli.vaultLoader.rustVault 'Reads scanned vault content'
  criv.cli.validator.rustAdr -> criv.cli.vaultLoader.rustVault 'Reads decisions'
  criv.cli.validator.rustAdr -> criv.cli.vaultLoader.rustConfig 'Reads the decision configuration'
  criv.cli.validator.rustAdr -> criv.cli.gitAccess.rustGit 'Reads decision history'
  criv.cli.validator.rustAdr -> criv.cli.validator.rustSourceReconcile 'Reconciles governed source scopes'
  criv.cli.validator.rustSourceReconcile -> criv.cli.gitAccess.rustGit 'Reads renames and deletions'
  criv.cli.validator.rustSourceReconcile -> criv.cli.vaultLoader.rustVault 'Reads governed source references'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.validator.rustCheck 'Runs the staged checks'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.validator.rustPolicyScan 'Runs the staged policy scan'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.validator.rustAdr 'Reads effective governance'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.validator.rustSourceReconcile 'Fails closed on stale scopes'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.gitAccess.rustGit 'Selects the staged change scope'
  criv.cli.enforcementGateway.rustEnforce -> criv.cli.vaultLoader.rustVault 'Loads the changed vault scope'

  // State publication.
  criv.cli.statePublisher.rustState -> criv.cli.vaultLoader.rustVault 'Builds the state envelope'
  criv.cli.statePublisher.rustState -> criv.cli.vaultLoader.rustC4 'Serializes C4 artifacts'
  criv.cli.statePublisher.rustState -> criv.cli.sourceAnalysis.rustSourceGraph 'Serializes source relations'
  criv.cli.statePublisher.rustState -> criv.cli.sourceAnalysis.rustStructural 'Serializes structural matches'
  criv.cli.statePublisher.rustState -> criv.cli.statePublisher.rustSnapshots 'Publishes retained snapshots'

  // Query and search.
  criv.cli.queryEngine.rustQuery -> criv.cli.vaultLoader.rustVault 'Resolves graph questions'
  criv.cli.queryEngine.rustQuery -> criv.cli.sourceAnalysis.rustSourceIndex 'Reads indexed sources'
  criv.cli.queryEngine.rustQuery -> criv.cli.sourceAnalysis.rustSourceGraph 'Reads module and import relations'
  criv.cli.queryEngine.rustQuery -> criv.cli.gitAccess.rustGit 'Reads commit history'
  criv.cli.queryEngine.rustQuery -> criv.cli.statePublisher.rustSnapshots 'Reads published snapshots'
  criv.cli.queryEngine.rustQuery -> criv.cli.architectureExporter.rustC4Code 'Reads the generated module graph'
  criv.cli.queryEngine.rustSearch -> criv.cli.sourceAnalysis.rustSourceIndex 'Searches indexed sources'
  criv.cli.queryEngine.rustSearch -> criv.cli.sourceAnalysis.rustStructural 'Matches structural patterns'
  criv.cli.queryEngine.rustSearch -> criv.cli.vaultLoader.rustVault 'Scopes searches to the vault'

  // Architecture export.
  criv.cli.architectureExporter.rustArchitecture -> criv.cli.architectureExporter.rustC4Code 'Renders the module architecture'
  criv.cli.architectureExporter.rustArchitecture -> criv.cli.vaultLoader.rustVault 'Reads the loaded vault'
  criv.cli.architectureExporter.rustArchitecture -> criv.cli.vaultLoader.rustConfig 'Reads the architecture configuration'
  criv.cli.architectureExporter.rustC4Code -> criv.cli.vaultLoader.rustVault 'Reads indexed vault data'
  criv.cli.architectureExporter.rustC4Code -> criv.cli.sourceAnalysis.rustSourceGraph 'Reads module and import data'

  // Vault initialization.
  criv.cli.initializer.rustInit -> criv.cli.initializer.rustGeneratedSkills 'Installs the skill inventory'
}
