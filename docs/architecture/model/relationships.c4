// Relationship labels use one convention: a capital letter, a present-tense
// verb first, and no preposition at the end. Add a technology when the
// relationship crosses a process, a language, or a storage boundary.
model {
  maintainer -> repository 'Writes code, documents, and decisions' {
    technology 'Editor and Git'
  }
  maintainer -> criv.cli 'Runs checks, refresh sessions, and queries' {
    technology 'Terminal'
  }
  maintainer -> criv.obsidianPlugin 'Reviews the documentation graph' {
    technology 'Obsidian user interface'
  }
  maintainer -> criv.vscodeExtension 'Edits and reviews the repository' {
    technology 'VS Code user interface'
  }
  githubActions -> criv.cli 'Validates every push and pull request' {
    technology 'Hosted runner and released binary'
  }

  criv.obsidianPlugin -> obsidian 'Draws views and opens files' {
    technology 'Obsidian plugin API'
  }
  criv.vscodeExtension -> vscode 'Draws views, diagnostics, and editors' {
    technology 'VS Code extension API'
  }

  criv.cli -> repository 'Reads source, documents, configuration, and commit history' {
    technology 'File system and libgit2'
  }
  criv.cli -> criv.stateStore 'Writes the validated state and retained snapshots' {
    technology 'Atomic JSON writes'
  }
  criv.obsidianPlugin -> criv.stateStore 'Reads the validated state' {
    technology 'JSON over the Obsidian file API'
  }
  criv.vscodeExtension -> criv.stateStore 'Reads the validated state' {
    technology 'JSON over the workspace file system'
  }
  criv.vscodeExtension -> criv.cli 'Starts check and refresh commands' {
    technology 'Child process'
  }
  criv.obsidianPlugin -> criv.sharedRenderer 'Renders C4 views' {
    technology 'Bundled npm package'
  }
  criv.vscodeExtension -> criv.sharedRenderer 'Renders C4 views' {
    technology 'Bundled npm package in a webview'
  }

  // criv CLI components.
  criv.cli.commandRouter -> criv.cli.initializer 'Installs the vault scaffold'
  criv.cli.commandRouter -> criv.cli.vaultLoader 'Runs one-shot load operations'
  criv.cli.commandRouter -> criv.cli.refreshPipeline 'Starts refresh and watch sessions'
  criv.cli.commandRouter -> criv.cli.validator 'Runs one-shot checks'
  criv.cli.commandRouter -> criv.cli.enforcementGateway 'Runs staged enforcement'
  criv.cli.commandRouter -> criv.cli.queryEngine 'Sends query requests'

  criv.cli.refreshPipeline -> criv.cli.vaultLoader 'Loads the current repository model'
  criv.cli.refreshPipeline -> criv.cli.sourceAnalysis 'Updates the live source index'
  criv.cli.refreshPipeline -> criv.cli.validator 'Validates the loaded vault'
  criv.cli.refreshPipeline -> criv.cli.architectureExporter 'Requests configured architecture output'
  criv.cli.refreshPipeline -> criv.cli.statePublisher 'Publishes the validated state'

  criv.cli.vaultLoader -> criv.cli.likec4Compiler 'Compiles and validates C4 sources' {
    technology 'Node.js bridge process'
  }
  criv.cli.vaultLoader -> criv.cli.sourceAnalysis 'Builds source indexes and relations'
  criv.cli.vaultLoader -> criv.cli.gitAccess 'Reads decision and document history'
  criv.cli.sourceAnalysis -> criv.cli.vaultLoader 'Reads the configured source roots'

  criv.cli.validator -> criv.cli.vaultLoader 'Reads the loaded repository artifacts'
  criv.cli.validator -> criv.cli.initializer 'Checks the generated skill inventory'
  criv.cli.validator -> criv.cli.sourceAnalysis 'Evaluates policy patterns against indexed sources'
  criv.cli.validator -> criv.cli.gitAccess 'Reconciles renamed and deleted source scopes'
  criv.cli.validator -> criv.cli.statePublisher 'Reads the previous published state'

  criv.cli.enforcementGateway -> criv.cli.validator 'Runs the staged checks'
  criv.cli.enforcementGateway -> criv.cli.gitAccess 'Selects the staged and pushed change scope'
  criv.cli.enforcementGateway -> criv.cli.vaultLoader 'Loads the changed vault scope'

  criv.cli.queryEngine -> criv.cli.vaultLoader 'Resolves knowledge graph questions'
  criv.cli.queryEngine -> criv.cli.gitAccess 'Reads commit history for graph questions'
  criv.cli.queryEngine -> criv.cli.sourceAnalysis 'Searches indexed sources and patterns'
  criv.cli.queryEngine -> criv.cli.architectureExporter 'Reads the generated module graph'
  criv.cli.queryEngine -> criv.cli.statePublisher 'Reads the published state'

  criv.cli.architectureExporter -> criv.cli.vaultLoader 'Reads the loaded repository model'
  criv.cli.architectureExporter -> criv.cli.sourceAnalysis 'Reads module and import relations'

  criv.cli.statePublisher -> criv.cli.vaultLoader 'Builds the state envelope'
  criv.cli.statePublisher -> criv.cli.sourceAnalysis 'Serializes source relations'
  criv.cli.statePublisher -> criv.stateStore 'Writes the envelope and retains snapshots' {
    technology 'Atomic JSON writes'
  }

  criv.cli.vaultLoader -> repository 'Reads documents, decisions, configuration, and sources' {
    technology 'File system'
  }
  criv.cli.gitAccess -> repository 'Reads commit history and changed files' {
    technology 'libgit2'
  }
  criv.cli.initializer -> repository 'Writes the vault scaffold and generated skills' {
    technology 'Confined atomic writes'
  }

  // Shared renderer components.
  criv.sharedRenderer.diagramRenderer -> criv.sharedRenderer.modelContract 'Reads the model and diagnostic contract'
  criv.sharedRenderer.modelCompiler -> criv.sharedRenderer.modelContract 'Emits the model and diagnostic contract'

  // Obsidian plugin components.
  criv.obsidianPlugin.obsidianController -> criv.obsidianPlugin.obsidianState 'Builds editor views'
  criv.obsidianPlugin.obsidianController -> criv.obsidianPlugin.obsidianWasm 'Resolves state and source selectors' {
    technology 'WebAssembly call'
  }
  criv.obsidianPlugin.obsidianController -> criv.sharedRenderer.diagramRenderer 'Renders and navigates C4 views'
  criv.obsidianPlugin.obsidianController -> criv.sharedRenderer.modelContract 'Reads the model contract'
  criv.obsidianPlugin.obsidianWasm -> criv.obsidianPlugin.obsidianState 'Maps validated state to editor snapshots'
  criv.obsidianPlugin.obsidianController -> criv.stateStore 'Reads the validated state' {
    technology 'Obsidian file API'
  }

  // VS Code extension components.
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodeState 'Observes workspace state'
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodePreview 'Registers and opens the custom editor'
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodeNavigation 'Registers source navigation'
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodeDiagnostics 'Publishes check diagnostics'
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodeCommands 'Registers editor commands'
  criv.vscodeExtension.vscodeController -> criv.vscodeExtension.vscodeExplorer 'Registers the vault tree'

  criv.vscodeExtension.vscodePreview -> criv.vscodeExtension.vscodeState 'Reads compiled C4 models'
  criv.vscodeExtension.vscodePreview -> criv.sharedRenderer.diagramRenderer 'Renders and navigates the selected view' {
    technology 'Webview message channel'
  }
  criv.vscodeExtension.vscodePreview -> criv.sharedRenderer.modelContract 'Reads the model contract'
  criv.vscodeExtension.vscodePreview -> criv.vscodeExtension.vscodeCommands 'Runs refresh commands for the preview'
  criv.vscodeExtension.vscodeNavigation -> criv.vscodeExtension.vscodeState 'Resolves source targets and hovers'
  criv.vscodeExtension.vscodeNavigation -> criv.vscodeExtension.vscodeCommands 'Offers command links'
  criv.vscodeExtension.vscodeExplorer -> criv.vscodeExtension.vscodeState 'Builds the tree from validated state'
  criv.vscodeExtension.vscodeDiagnostics -> criv.vscodeExtension.vscodeCommands 'Reads check output'
  criv.vscodeExtension.vscodeCommands -> criv.cli 'Starts check and refresh commands' {
    technology 'Child process'
  }
  criv.vscodeExtension.vscodeState -> criv.stateStore 'Reads the validated state' {
    technology 'Workspace file system'
  }
}
