+#[cfg(test)]
+fn discovery_probe_source_files(root: &std::path::Path) -> Result<Vec<String>> {
+    let config = config::Config::load(root)?;
+    let mut lifecycle = source::SourceIndexLifecycle::for_command(root, &config)?;
