+#[cfg(test)]
+fn discovery_probe_vault_files(
+    root: &std::path::Path,
+) -> Result<(Vec<String>, Vec<String>)> {
+    let config = config::Config::load(root)?;
+    let docs = config.docs_path(root);
+    let markdown = util::walk_vault_files(root, &docs, Some("md"))?
+        .into_iter()
+        .map(|path| discovery_probe_relative(root, &path))
+        .collect::<Result<Vec<_>>>()?;
+    let c4 = util::walk_vault_files(root, &docs, Some("c4"))?
+        .into_iter()
+        .map(|path| discovery_probe_relative(root, &path))
+        .collect::<Result<Vec<_>>>()?;
+    Ok((markdown, c4))
+}
+
+#[cfg(test)]
+fn discovery_probe_relative(root: &std::path::Path, path: &std::path::Path) -> Result<String> {
+    let relative = path.strip_prefix(root).map_err(|_| {
+        CrivError::new(format!(
+            "discovery probe path {} is outside {}",
+            path.display(),
+            root.display()
+        ))
+    })?;
+    let relative = relative.to_str().ok_or_else(|| {
+        CrivError::new(format!(
+            "discovery probe path {} is not valid UTF-8",
+            path.display()
+        ))
+    })?;
+    Ok(relative.replace(std::path::MAIN_SEPARATOR, "/"))
+}
