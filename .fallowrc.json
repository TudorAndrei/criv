{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.40.0/schema.json",
  "entry": [
    "extensions/vscode-criv/test/unit/**/*.test.ts",
    "extensions/vscode-criv/test/integration/runner.ts",
    ".obsidian/plugins/criv/test/**/*.test.ts"
  ],
  "ignorePatterns": [
    "!.obsidian/plugins/criv/*.{json,mjs}",
    "!.obsidian/plugins/criv/src/**",
    "!.obsidian/plugins/criv/test/*.ts",
    "!.obsidian/plugins/criv/scripts/**",
    "crates/**",
    "scripts/**",
    "site/**",
    "tests/**"
  ],
  "ignoreDependencies": ["@oxfmt/binding-*", "@oxlint/binding-*"],
  "ignoreBinaries": ["mdbook", "mise"],
  "usedClassMembers": [
    {
      "extends": "Error",
      "members": ["code"]
    },
    {
      "implements": "vscode.Disposable",
      "members": ["dispose"]
    },
    {
      "implements": "vscode.TreeDataProvider",
      "members": ["onDidChangeTreeData"]
    }
  ]
}
