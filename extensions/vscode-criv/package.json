{
  "name": "vscode-criv",
  "displayName": "criv",
  "version": "0.1.0",
  "description": "VS Code-compatible companion extension for criv repository state.",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "adr",
    "criv",
    "cursor",
    "documentation",
    "policy"
  ],
  "homepage": "https://github.com/TudorAndrei/criv#readme",
  "bugs": {
    "url": "https://github.com/TudorAndrei/criv/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TudorAndrei/criv"
  },
  "publisher": "criv",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run build:wasm && npm run check-types && node esbuild.config.mjs --production",
    "build:wasm": "npm --prefix ../../packages/criv-editor-state run build:wasm",
    "check-types": "tsc --noEmit -p .",
    "dev": "node esbuild.config.mjs --watch",
    "format": "oxfmt --write src test scripts esbuild.config.mjs",
    "format:check": "oxfmt --check src test scripts esbuild.config.mjs",
    "lint": "oxlint src test scripts esbuild.config.mjs",
    "package": "vsce package --no-dependencies --out vscode-criv.vsix",
    "test": "npm run build:wasm && npm run check-types && node scripts/build-tests.mjs && node --test \"dist-test/unit/**/*.test.js\"",
    "test:integration": "npm run build && node scripts/build-tests.mjs --integration && node test/run-integration.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@criv/editor-state": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "criv.refreshStateView",
        "title": "criv: Refresh State View"
      },
      {
        "command": "criv.openStateJson",
        "title": "criv: Open State JSON"
      },
      {
        "command": "criv.openSourceTarget",
        "title": "criv: Open Source Target"
      },
      {
        "command": "criv.openAsset",
        "title": "criv: Open Documentation Asset"
      },
      {
        "command": "criv.runWatchOnce",
        "title": "criv: Run Watch Once"
      },
      {
        "command": "criv.runCheck",
        "title": "criv: Run Check"
      },
      {
        "command": "criv.queryUndocumentedCode",
        "title": "criv: Query Undocumented Code"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "criv.stateView",
          "name": "criv State",
          "icon": "assets/criv.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "criv.refreshStateView",
          "when": "view == criv.stateView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "criv",
      "properties": {
        "criv.binaryPath": {
          "type": "string",
          "scope": "machine",
          "default": "criv",
          "description": "Path to the criv executable used for workspace commands."
        },
        "criv.automaticRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the loaded criv state after extension-triggered watch commands."
        },
        "criv.checkOnSave": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "Run criv check when Markdown files are saved in a trusted workspace."
        }
      }
    }
  },
  "activationEvents": [
    "workspaceContains:criv.toml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The extension can inspect workspace files, but criv command execution requires workspace trust."
    }
  }
}
