{
  "name": "vscode-criv",
  "displayName": "criv",
  "version": "0.1.0",
  "publisher": "criv",
  "description": "VS Code-compatible companion extension for criv repository state.",
  "license": "MIT",
  "homepage": "https://github.com/TudorAndrei/criv#readme",
  "bugs": {
    "url": "https://github.com/TudorAndrei/criv/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TudorAndrei/criv"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "criv",
    "documentation",
    "architecture",
    "c4",
    "cursor"
  ],
  "activationEvents": [
    "workspaceContains:criv.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The extension can inspect workspace files, but criv command execution requires workspace trust."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "criv.refreshStateView",
        "title": "criv: Refresh State View"
      },
      {
        "command": "criv.openStateJson",
        "title": "criv: Open State JSON"
      },
      {
        "command": "criv.openSourceTarget",
        "title": "criv: Open Source Target"
      },
      {
        "command": "criv.runWatchOnce",
        "title": "criv: Run Watch Once"
      },
      {
        "command": "criv.runCheck",
        "title": "criv: Run Check"
      },
      {
        "command": "criv.queryUndocumentedCode",
        "title": "criv: Query Undocumented Code"
      },
      {
        "command": "criv.previewC4",
        "title": "criv: Preview C4 Artifact",
        "icon": "$(open-preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "criv.c4Preview",
        "displayName": "criv LikeC4 Preview",
        "selector": [
          {
            "filenamePattern": "*.c4"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "criv.stateView",
          "name": "criv State",
          "icon": "assets/criv.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "criv.previewC4",
          "when": "resourceLangId =~ /^(criv-c4|likec4)$/ && activeCustomEditorId != criv.c4Preview",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "criv.refreshStateView",
          "when": "view == criv.stateView",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "criv-c4",
        "aliases": [
          "criv C4",
          "C4"
        ],
        "extensions": [
          ".c4"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "criv",
      "properties": {
        "criv.binaryPath": {
          "type": "string",
          "scope": "machine",
          "default": "criv",
          "description": "Path to the criv executable used for workspace commands."
        },
        "criv.automaticRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the loaded criv state after extension-triggered watch commands."
        },
        "criv.checkOnSave": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "Run criv check when Markdown or .c4 files are saved in a trusted workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check-types && node esbuild.config.mjs --production",
    "build:wasm": "mise exec cargo:wasm-pack@0.15.0 rust@1.97.1 -- wasm-pack build ../../crates/criv-wasm --target nodejs --out-dir ../../extensions/vscode-criv/pkg",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.config.mjs",
    "compile:integration-tests": "esbuild test/integration/runner.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist-test/integration/runner.js",
    "compile:unit-tests": "esbuild test/unit/*.test.ts --bundle --platform=node --format=cjs --target=node18 --external:../pkg/criv_wasm.js --outdir=dist-test/unit",
    "format": "oxfmt --write src test scripts esbuild.config.mjs",
    "format:check": "oxfmt --check src test scripts esbuild.config.mjs",
    "lint": "oxlint src test scripts esbuild.config.mjs",
    "package": "vsce package --no-dependencies --out vscode-criv.vsix",
    "test": "npm run build:wasm && npm run compile && npm run compile:unit-tests && node --test dist-test/unit/*.test.js",
    "test:integration": "npm run compile && npm run compile:integration-tests && node test/run-integration.mjs",
    "vscode:prepublish": "npm run build && npm run build:wasm",
    "watch": "node esbuild.config.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.28.1",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@criv/likec4": "0.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
