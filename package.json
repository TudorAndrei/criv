{
  "name": "criv-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/criv-editor-state",
    ".obsidian/plugins/criv",
    "extensions/vscode-criv"
  ],
  "scripts": {
    "format:markdown": "oxfmt --write '**/*.md'",
    "format:markdown:check": "oxfmt --check '**/*.md'",
    "check:editor-contracts": "npm --prefix packages/criv-editor-state run lint && npm --prefix packages/criv-editor-state run format:check && npm --prefix packages/criv-editor-state run check-types && npm --prefix packages/criv-editor-state test && cargo test --locked -p criv-wasm",
    "build:site": "node scripts/prepare-docs-site.mjs && mdbook build .site-build/docs-book"
  },
  "devDependencies": {
    "oxfmt": "0.75.0"
  },
  "optionalDependencies": {
    "@oxfmt/binding-linux-arm64-gnu": "0.75.0",
    "@oxfmt/binding-linux-x64-gnu": "0.75.0",
    "@oxlint/binding-linux-arm64-gnu": "1.90.0",
    "@oxlint/binding-linux-x64-gnu": "1.90.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
