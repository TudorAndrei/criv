{
  "name": "criv-obsidian-plugin",
  "version": "0.1.0",
  "description": "Obsidian companion plugin for criv vault state.",
  "keywords": [
    "criv",
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "npm run build:wasm && npm run check-types && node esbuild.config.mjs --production",
    "build:wasm": "npm --prefix ../../../packages/criv-editor-state run build:wasm",
    "check-types": "tsc --noEmit -p .",
    "dev": "node esbuild.config.mjs --watch",
    "format": "oxfmt --write src test scripts esbuild.config.mjs",
    "format:check": "oxfmt --check src test scripts esbuild.config.mjs",
    "lint": "oxlint src test scripts esbuild.config.mjs",
    "test": "npm run build:wasm && npm run check-types && node scripts/build-tests.mjs && node --test \"dist-test/**/*.test.cjs\""
  },
  "dependencies": {
    "@criv/editor-state": "0.1.0",
    "obsidian": "1.14.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
